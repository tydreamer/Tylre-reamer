@inherits LayoutComponentBase
@inject AuthService Auth
@inject NavigationManager Navigation

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <AuthorizeView>
                <Authorized>
                    <span class="me-3">@context.User.FindFirst("name")?.Value</span>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="SignOut">Sign Out</button>
                </Authorized>
                <NotAuthorized>
                    <a class="btn btn-outline-primary btn-sm" href="sign-in">Sign In</a>
                    <a class="btn btn-primary btn-sm" href="sign-up">Sign Up</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    private async Task SignOut()
    {
        await Auth.LogoutAsync();
        Navigation.NavigateTo("/sign-in");
    }
}
