@inherits LayoutComponentBase
@implements IDisposable
@inject AuthService Auth
@inject CartService Cart
@inject NavigationManager Navigation

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <AuthorizeView>
                <Authorized>
                    <div class="top-row-actions">
                        @if (context.User.IsInRole("Customer"))
                        {
                            <span class="position-relative">
                                <a class="btn btn-outline-secondary btn-sm" href="cart">Cart</a>
                                @if (Cart.TotalQuantity > 0)
                                {
                                    <span class="badge rounded-pill bg-danger position-absolute top-0 start-100 translate-middle" style="z-index:1">
                                        @Cart.TotalQuantity
                                    </span>
                                }
                            </span>
                        }
                        <span class="top-row-user text-muted d-none d-md-inline">@context.User.FindFirst("name")?.Value</span>
                        <button class="btn btn-outline-secondary btn-sm" @onclick="SignOut">Sign Out</button>
                    </div>
                </Authorized>
                <NotAuthorized>
                    <div class="top-row-actions">
                        <a class="btn btn-outline-primary btn-sm" href="sign-in">Sign In</a>
                        <a class="btn btn-primary btn-sm" href="sign-up">Sign Up</a>
                    </div>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<AuthorizeView>
    <Authorized>
        <CartInitializer />
        <NotificationToast />
    </Authorized>
</AuthorizeView>

@code {
    protected override async Task OnInitializedAsync()
    {
        Cart.OnChange += StateHasChanged;
        Navigation.LocationChanged += OnLocationChanged;
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        await Cart.RefreshFromStorageAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task SignOut()
    {
        await Auth.LogoutAsync();
        Navigation.NavigateTo("/sign-in");
    }

    public void Dispose()
    {
        Cart.OnChange -= StateHasChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
