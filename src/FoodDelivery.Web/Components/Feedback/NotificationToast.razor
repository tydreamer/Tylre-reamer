@implements IAsyncDisposable
@inject OrderNotificationService Notifications
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider

<div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1080;">
    @foreach (var toast in toasts)
    {
        <div class="toast show mb-2" role="alert">
            <div class="toast-header">
                <strong class="me-auto">Order #@toast.OrderId</strong>
                <button type="button" class="btn-close" @onclick="() => Dismiss(toast)"></button>
            </div>
            <div class="toast-body" role="button" @onclick="() => Open(toast)">
                @OrderStatusNotificationMessages.Format(toast, isOwner)
            </div>
        </div>
    }
</div>

@code {
    private readonly List<OrderStatusNotification> toasts = new();
    private bool isOwner;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthStateProvider.GetAuthenticationStateAsync()).User;
        isOwner = user.IsInRole("Owner");
        Notifications.OnOrderStatusChanged += HandleStatusChanged;
        await Notifications.StartAsync();
    }

    private void HandleStatusChanged(OrderStatusNotification notification)
    {
        toasts.Add(notification);
        InvokeAsync(StateHasChanged);
        _ = AutoDismissAsync(notification);
    }

    private async Task AutoDismissAsync(OrderStatusNotification notification)
    {
        await Task.Delay(6000);
        Dismiss(notification);
    }

    private void Dismiss(OrderStatusNotification notification)
    {
        if (toasts.Remove(notification))
            InvokeAsync(StateHasChanged);
    }

    private void Open(OrderStatusNotification notification)
    {
        Dismiss(notification);
        var path = isOwner
            ? $"owner/orders/{notification.OrderId}"
            : $"orders/{notification.OrderId}";
        Navigation.NavigateTo(path);
    }

    public async ValueTask DisposeAsync()
    {
        Notifications.OnOrderStatusChanged -= HandleStatusChanged;
        await Notifications.DisposeAsync();
    }
}
