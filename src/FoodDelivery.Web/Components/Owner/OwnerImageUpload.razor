@inject IConfiguration Configuration

<div class="owner-image-upload">
    <p class="form-label">@Label</p>

    @if (HasImage)
    {
        <div class="owner-image-upload-preview">
            <img src="@PreviewUrl" alt="@PreviewAlt" class="owner-image-upload-preview-img" />
            <button type="button" class="owner-form-image-remove"
                    disabled="@Disabled"
                    title="Remove image"
                    @onclick="RemoveImage">
                <i class="bi bi-x" aria-hidden="true"></i>
            </button>
        </div>
    }
    else
    {
        <div class="owner-image-upload-dropzone">
            <i class="bi bi-image owner-image-upload-icon" aria-hidden="true"></i>
            <p class="owner-image-upload-hint">
                Drag and drop or click below to select a photo to upload.
            </p>
            <label for="@inputId" class="btn btn-dark owner-image-upload-btn @(Disabled ? "disabled" : "")">
                <i class="bi bi-upload me-2" aria-hidden="true"></i>Choose photo
            </label>
            <p class="owner-image-upload-meta">JPG, PNG, or WebP · up to 5 MB</p>
        </div>
    }

    <InputFile id="@inputId"
               OnChange="OnFileSelected"
               accept="image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp"
               style="display:none"
               disabled="@Disabled" />

    @if (validationError is not null)
    {
        <div class="text-danger small mt-1">@validationError</div>
    }
</div>

@code {
    private const long MaxFileBytes = ImageUploadService.MaxFileBytes;
    private readonly string inputId = $"owner-img-{Guid.NewGuid():N}";

    [Parameter, EditorRequired] public string Label { get; set; } = "Image";
    [Parameter] public string? ExistingImageUrl { get; set; }
    [Parameter] public ImageUploadSelection Selection { get; set; } = new();
    [Parameter] public EventCallback<ImageUploadSelection> SelectionChanged { get; set; }
    [Parameter] public string PreviewAlt { get; set; } = "Image preview";
    [Parameter] public bool Disabled { get; set; }

    private string? validationError;
    private string ApiBaseUrl => Configuration["ApiBaseUrl"] ?? "";

    private string? PreviewUrl =>
        Selection.PendingPreviewDataUrl
        ?? (Selection.Removed ? null : MediaUrlHelper.Resolve(ExistingImageUrl, ApiBaseUrl));

    private bool HasImage => PreviewUrl is not null;

    private async Task RemoveImage()
    {
        Selection = new ImageUploadSelection { Removed = true };
        await SelectionChanged.InvokeAsync(Selection);
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        validationError = null;
        var file = e.File;
        if (file.Size > MaxFileBytes)
        {
            validationError = "Image must be 5 MB or smaller.";
            return;
        }

        Selection.PendingFile = file;
        Selection.Removed = false;
        Selection.PendingPreviewDataUrl = await CreatePreviewDataUrlAsync(file);
        await SelectionChanged.InvokeAsync(Selection);
    }

    private static async Task<string> CreatePreviewDataUrlAsync(IBrowserFile file)
    {
        await using var stream = file.OpenReadStream(MaxFileBytes);
        using var memory = new MemoryStream();
        await stream.CopyToAsync(memory);
        var base64 = Convert.ToBase64String(memory.ToArray());
        return $"data:{file.ContentType};base64,{base64}";
    }
}
