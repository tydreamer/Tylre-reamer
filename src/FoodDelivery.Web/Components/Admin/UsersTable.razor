@if (Paged is null)
{
    <p><em>Loading...</em></p>
}
else if (Paged.TotalCount == 0)
{
    <EmptyState Icon="bi bi-people" Message="No users yet." />
}
else
{
    <PaginatedPageContent>
    <div class="table-responsive">
        <table class="table align-middle mb-0 users-list-table">
            <colgroup>
                <col class="col-name" />
                <col class="col-email" />
                <col class="col-role" />
                <col class="col-status" />
                <col class="col-actions" />
            </colgroup>
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Paged.Items)
                {
                    <tr>
                        <td title="@user.Name">@user.Name</td>
                        <td title="@user.Email">@user.Email</td>
                        <td>@(user.Role == "Customer" ? "Regular User" : "Restaurant Owner")</td>
                        <td>
                            @if (user.IsBlocked)
                            {
                                <span class="badge bg-danger">Blocked</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Active</span>
                            }
                        </td>
                        <td class="col-actions text-end text-nowrap">
                            @if (user.IsBlocked)
                            {
                                <button class="btn btn-sm btn-outline-success"
                                        disabled="@Busy"
                                        @onclick="() => OnUnblock.InvokeAsync(user.Id)">
                                    Unblock
                                </button>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-danger"
                                        disabled="@Busy"
                                        @onclick="() => OnRequestBlock.InvokeAsync(user)">
                                    Block
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    </PaginatedPageContent>

    <PaginationBar CurrentPage="CurrentPage" TotalPages="Paged.TotalPages"
                   TotalCount="Paged.TotalCount" PageSize="PageSize"
                   OnPageChanged="OnPageChanged" OnPageSizeChanged="OnPageSizeChanged" />
}

@code {
    [Parameter] public PagedResult<UserDto>? Paged { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public int CurrentPage { get; set; }
    [Parameter] public int PageSize { get; set; }
    [Parameter, EditorRequired] public EventCallback<int> OnPageChanged { get; set; }
    [Parameter, EditorRequired] public EventCallback<int> OnPageSizeChanged { get; set; }
    [Parameter, EditorRequired] public EventCallback<UserDto> OnRequestBlock { get; set; }
    [Parameter, EditorRequired] public EventCallback<int> OnUnblock { get; set; }
}
