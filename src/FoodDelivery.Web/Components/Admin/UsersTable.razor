@if (Paged is null)
{
    <p><em>Loading...</em></p>
}
else if (Paged.TotalCount == 0)
{
    <EmptyState Icon="bi bi-people" Title="No users yet" Message="Create a user to get started.">
        <a href="admin/users/new" class="btn btn-primary">Create User</a>
    </EmptyState>
}
else
{
    <PaginatedPageContent>
    <div class="table-responsive">
        <table class="table align-middle mb-0 users-list-table">
            <colgroup>
                <col class="col-name" />
                <col class="col-email" />
                <col class="col-user-type" />
                <col class="col-status" />
                <col class="col-actions" />
            </colgroup>
            <thead>
                <tr>
                    <SortableTableHeader ColumnKey="name" Label="Name" Class="col-name"
                                         CurrentSortBy="@SortBy" SortDesc="@SortDesc" OnSortChanged="OnSortChanged" />
                    <SortableTableHeader ColumnKey="email" Label="Email" Class="col-email"
                                         CurrentSortBy="@SortBy" SortDesc="@SortDesc" OnSortChanged="OnSortChanged" />
                    <SortableTableHeader ColumnKey="role" Label="User Type" Class="col-user-type"
                                         CurrentSortBy="@SortBy" SortDesc="@SortDesc" OnSortChanged="OnSortChanged" />
                    <SortableTableHeader ColumnKey="status" Label="Status" Class="col-status text-center"
                                         CurrentSortBy="@SortBy" SortDesc="@SortDesc" OnSortChanged="OnSortChanged" />
                    <th class="col-actions"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Paged.Items)
                {
                    <tr>
                        <td title="@user.Name">@user.Name</td>
                        <td title="@user.Email">@user.Email</td>
                        <td>@(user.Role == "Customer" ? "Regular User" : "Restaurant Owner")</td>
                        <td class="col-status text-center">
                            @if (user.IsBlocked)
                            {
                                <span class="badge bg-danger">Blocked</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Active</span>
                            }
                        </td>
                        <td class="col-actions text-end text-nowrap">
                            @if (user.IsBlocked)
                            {
                                <button class="btn btn-sm btn-outline-success"
                                        disabled="@Busy"
                                        @onclick="() => OnUnblock.InvokeAsync(user.Id)">
                                    Unblock
                                </button>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-danger"
                                        disabled="@Busy"
                                        @onclick="() => OnRequestBlock.InvokeAsync(user)">
                                    Block
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    </PaginatedPageContent>

    <PaginationBar CurrentPage="CurrentPage" TotalPages="Paged.TotalPages"
                   TotalCount="Paged.TotalCount" PageSize="PageSize"
                   OnPageChanged="OnPageChanged" OnPageSizeChanged="OnPageSizeChanged" />
}

@code {
    [Parameter] public PagedResult<UserDto>? Paged { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public int CurrentPage { get; set; }
    [Parameter] public int PageSize { get; set; }
    [Parameter] public string SortBy { get; set; } = "name";
    [Parameter] public bool SortDesc { get; set; }
    [Parameter, EditorRequired] public EventCallback<int> OnPageChanged { get; set; }
    [Parameter, EditorRequired] public EventCallback<int> OnPageSizeChanged { get; set; }
    [Parameter, EditorRequired] public EventCallback<(string SortBy, bool SortDesc)> OnSortChanged { get; set; }
    [Parameter, EditorRequired] public EventCallback<UserDto> OnRequestBlock { get; set; }
    [Parameter, EditorRequired] public EventCallback<int> OnUnblock { get; set; }
}
