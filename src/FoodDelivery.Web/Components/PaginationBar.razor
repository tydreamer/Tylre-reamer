@if (TotalPages > 0 || TotalCount > 0)
{
    <footer class="pagination-bar-footer" aria-label="Table pagination">
        <div class="pagination-bar-pages">
            @if (TotalPages > 0)
            {
                <div class="d-flex d-sm-none align-items-center justify-content-center gap-2">
                    <button type="button" class="btn btn-sm btn-outline-secondary"
                            disabled="@(CurrentPage == 1)"
                            @onclick="() => OnPageChanged.InvokeAsync(CurrentPage - 1)">
                        Previous
                    </button>
                    <span class="small text-muted text-nowrap">Page @CurrentPage of @TotalPages</span>
                    <button type="button" class="btn btn-sm btn-outline-secondary"
                            disabled="@(CurrentPage == TotalPages)"
                            @onclick="() => OnPageChanged.InvokeAsync(CurrentPage + 1)">
                        Next
                    </button>
                </div>

                <nav class="d-none d-sm-block pagination-bar-nav" aria-label="Page navigation">
                    <ul class="pagination pagination-sm mb-0 flex-nowrap justify-content-center">
                        <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                            <button type="button" class="page-link" aria-label="Previous page"
                                    @onclick="() => OnPageChanged.InvokeAsync(CurrentPage - 1)">‹</button>
                        </li>
                        @foreach (var entry in GetPageEntries())
                        {
                            @if (entry is null)
                            {
                                <li class="page-item disabled">
                                    <span class="page-link">…</span>
                                </li>
                            }
                            else
                            {
                                var pageNum = entry.Value;
                                <li class="page-item @(pageNum == CurrentPage ? "active" : "")">
                                    <button type="button" class="page-link" aria-label="Page @pageNum"
                                            aria-current="@(pageNum == CurrentPage ? "page" : null)"
                                            @onclick="() => OnPageChanged.InvokeAsync(pageNum)">@pageNum</button>
                                </li>
                            }
                        }
                        <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                            <button type="button" class="page-link" aria-label="Next page"
                                    @onclick="() => OnPageChanged.InvokeAsync(CurrentPage + 1)">›</button>
                        </li>
                    </ul>
                </nav>
            }
        </div>

        <div class="pagination-bar-size">
            <label class="pagination-bar-size-label text-muted" for="@pageSizeSelectId">Rows per page</label>
            <select id="@pageSizeSelectId" class="form-select form-select-sm pagination-bar-size-select"
                    value="@PageSize"
                    @onchange="e => OnPageSizeChanged.InvokeAsync(int.Parse(e.Value!.ToString()!))">
                @foreach (var size in PageSizeOptions)
                {
                    <option value="@size">@size</option>
                }
            </select>
            <span class="text-muted pagination-bar-range text-nowrap">
                @RangeLabel
            </span>
        </div>
    </footer>
}

@code {
    private readonly string pageSizeSelectId = $"page-size-{Guid.NewGuid():N}";

    [Parameter, EditorRequired] public int CurrentPage { get; set; }
    [Parameter, EditorRequired] public int TotalPages { get; set; }
    [Parameter, EditorRequired] public int TotalCount { get; set; }
    [Parameter, EditorRequired] public int PageSize { get; set; }
    [Parameter] public int[] PageSizeOptions { get; set; } = [10, 25, 50];
    [Parameter, EditorRequired] public EventCallback<int> OnPageChanged { get; set; }
    [Parameter, EditorRequired] public EventCallback<int> OnPageSizeChanged { get; set; }

    private string RangeLabel => TotalCount == 0
        ? "0 of 0"
        : $"{(CurrentPage - 1) * PageSize + 1}–{Math.Min(CurrentPage * PageSize, TotalCount)} of {TotalCount}";

    private IEnumerable<int?> GetPageEntries()
    {
        if (TotalPages <= 1)
            return TotalPages == 1 ? [1] : [];

        if (TotalPages <= 7)
            return Enumerable.Range(1, TotalPages).Select(p => (int?)p);

        var pages = new SortedSet<int> { 1, TotalPages, CurrentPage };
        for (var offset = -1; offset <= 1; offset++)
        {
            var page = CurrentPage + offset;
            if (page >= 1 && page <= TotalPages)
                pages.Add(page);
        }

        var result = new List<int?>();
        var previous = 0;
        foreach (var page in pages)
        {
            if (previous > 0 && page - previous > 1)
                result.Add(null);

            result.Add(page);
            previous = page;
        }

        return result;
    }
}
