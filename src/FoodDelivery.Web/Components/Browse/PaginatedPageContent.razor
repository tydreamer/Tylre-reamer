@inject PaginatedPageLoadService PageLoad

<div class="paginated-page-content @Class" @ref="contentRoot">
    @if (PageLoad.IsLoading)
    {
        <div class="paginated-page-loading-overlay" aria-live="polite" aria-busy="true">
            <div class="paginated-page-loading-spinner">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading page…</span>
                </div>
            </div>
        </div>
    }
    @ChildContent
</div>

@code {
    private ElementReference contentRoot;

    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Class { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender) =>
        await PageLoad.TryCompleteAfterRenderAsync(contentRoot, () => InvokeAsync(StateHasChanged));
}
