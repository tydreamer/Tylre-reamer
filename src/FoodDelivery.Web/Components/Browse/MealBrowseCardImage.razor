<div class="meal-card-thumb">
    @if (ShowPlaceholder)
    {
        <div class="meal-card-thumb-placeholder">
            <i class="bi bi-fork-knife meal-card-thumb-icon" aria-hidden="true"></i>
            <span class="meal-card-thumb-name">@Name</span>
        </div>
    }
    @if (HasImage && !imageLoadFailed)
    {
        <img src="@ImageUrl"
             class="meal-card-thumb-img @(imageLoaded ? "is-loaded" : "")"
             alt="@Name"
             @onload="OnImageLoaded"
             @onerror="OnImageError" />
    }
    @if (!string.IsNullOrWhiteSpace(RestaurantName))
    {
        <span class="badge meal-restaurant-badge meal-card-truncate" title="@RestaurantName">@RestaurantName</span>
    }
</div>

@code {
    private bool imageLoaded;
    private bool imageLoadFailed;
    private string? previousImageUrl;

    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public string? ImageUrl { get; set; }
    [Parameter] public string? RestaurantName { get; set; }

    private bool HasImage => !string.IsNullOrWhiteSpace(ImageUrl);

    private bool ShowPlaceholder => !HasImage || imageLoadFailed || !imageLoaded;

    protected override void OnParametersSet()
    {
        if (!string.Equals(previousImageUrl, ImageUrl, StringComparison.Ordinal))
        {
            previousImageUrl = ImageUrl;
            imageLoaded = false;
            imageLoadFailed = false;
        }
    }

    private void OnImageLoaded() => imageLoaded = true;

    private void OnImageError() => imageLoadFailed = true;
}
