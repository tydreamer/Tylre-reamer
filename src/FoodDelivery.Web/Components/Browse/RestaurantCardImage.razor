<div class="restaurant-card-thumb">
    @if (ShowPlaceholder)
    {
        <div class="restaurant-card-thumb-placeholder">
            <i class="bi bi-shop restaurant-card-thumb-icon" aria-hidden="true"></i>
            <span class="restaurant-card-thumb-name">@Name</span>
        </div>
    }
    else
    {
        <img src="@ImageUrl" class="restaurant-card-thumb-img" alt="@Name" @onerror="OnImageError" />
    }
</div>

@code {
    private bool imageLoadFailed;
    private string? previousImageUrl;

    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public string? ImageUrl { get; set; }

    private bool HasImage => !string.IsNullOrWhiteSpace(ImageUrl);

    private bool ShowPlaceholder => !HasImage || imageLoadFailed;

    protected override void OnParametersSet()
    {
        if (!string.Equals(previousImageUrl, ImageUrl, StringComparison.Ordinal))
        {
            previousImageUrl = ImageUrl;
            imageLoadFailed = false;
        }
    }

    private void OnImageError() => imageLoadFailed = true;
}
