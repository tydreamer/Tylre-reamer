<div class="table-responsive d-none d-md-block">
    <table class="table align-middle mb-0">
        <thead>
            <tr>
                <th>Meal</th>
                <th class="text-end">Price</th>
                <th class="text-center text-nowrap">Quantity</th>
                <th class="text-end">Total</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Items)
            {
                <tr>
                    <td>@item.Meal.Name</td>
                    <td class="text-end text-nowrap">@item.Meal.Price.ToString("C")</td>
                    <td class="text-center">
                        <CartQuantityControl Quantity="@item.Quantity"
                                             DecreaseDisabled="@(item.Quantity <= 1)"
                                             OnDecrease="() => OnDecrease.InvokeAsync(item.Meal.Id)"
                                             OnIncrease="() => OnIncrease.InvokeAsync(item.Meal.Id)" />
                    </td>
                    <td class="text-end text-nowrap">@item.LineTotal.ToString("C")</td>
                    <td class="text-end text-nowrap">
                        <button type="button" class="btn btn-sm btn-outline-danger cart-remove-btn"
                                title="Remove"
                                aria-label="@($"Remove {item.Meal.Name} from cart")"
                                @onclick="() => OnRemove.InvokeAsync(item.Meal.Id)">
                            <i class="bi bi-trash" aria-hidden="true"></i>
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyCollection<CartItem> Items { get; set; } = [];
    [Parameter, EditorRequired] public EventCallback<int> OnDecrease { get; set; }
    [Parameter, EditorRequired] public EventCallback<int> OnIncrease { get; set; }
    [Parameter, EditorRequired] public EventCallback<int> OnRemove { get; set; }
}
