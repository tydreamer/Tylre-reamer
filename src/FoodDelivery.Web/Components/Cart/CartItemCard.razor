<div class="card cart-item-card shadow-sm">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
            <div class="flex-grow-1 overflow-hidden">
                <h6 class="card-title mb-1">@Item.Meal.Name</h6>
                <div class="text-muted small">@Item.Meal.Price.ToString("C") each</div>
            </div>
            <div class="cart-item-total">@Item.LineTotal.ToString("C")</div>
        </div>
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
            <CartQuantityControl Quantity="@Item.Quantity"
                                 DecreaseDisabled="@(Item.Quantity <= 1)"
                                 OnDecrease="OnDecrease"
                                 OnIncrease="OnIncrease" />
            <button type="button" class="btn btn-sm btn-outline-danger cart-remove-btn"
                    title="Remove"
                    aria-label="@($"Remove {Item.Meal.Name} from cart")"
                    @onclick="OnRemove">
                <i class="bi bi-trash" aria-hidden="true"></i>
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public CartItem Item { get; set; } = default!;
    [Parameter, EditorRequired] public EventCallback OnDecrease { get; set; }
    [Parameter, EditorRequired] public EventCallback OnIncrease { get; set; }
    [Parameter, EditorRequired] public EventCallback OnRemove { get; set; }
}
