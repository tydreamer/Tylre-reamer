@page "/admin/users"
@attribute [Authorize(Roles = "Admin")]
@inject UserService Users

<PageTitle>Create & Block Users</PageTitle>

<h1 class="mb-4">Create &amp; Block Users</h1>

@if (successMessage is not null)
{
    <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1080;">
        <div class="toast show" role="alert">
            <div class="toast-header bg-success text-white">
                <strong class="me-auto">Success</strong>
                <button type="button" class="btn-close btn-close-white" @onclick="() => successMessage = null"></button>
            </div>
            <div class="toast-body">@successMessage</div>
        </div>
    </div>
}

<div class="row g-4">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title mb-3">Add New User</h5>
                <EditForm Model="model" OnValidSubmit="CreateUser">
                    <DataAnnotationsValidator />
                    <div class="mb-3">
                        <label class="form-label">Name</label>
                        <InputText class="form-control" @bind-Value="model.Name" />
                        <FirstValidationMessage For="() => model.Name" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <InputText class="form-control" type="email" @bind-Value="model.Email" />
                        <FirstValidationMessage For="() => model.Email" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Password</label>
                        <InputText class="form-control" type="password" @bind-Value="model.Password" />
                        <FirstValidationMessage For="() => model.Password" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Role</label>
                        <InputSelect class="form-select" @bind-Value="model.Role">
                            <option value="Customer">Regular User</option>
                            <option value="Owner">Restaurant Owner</option>
                        </InputSelect>
                    </div>
                    @if (error is not null)
                    {
                        <div class="alert alert-danger">@error</div>
                    }
                    <button class="btn btn-primary w-100" type="submit" disabled="@busy">Create User</button>
                </EditForm>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        @if (paged is null)
        {
            <p><em>Loading...</em></p>
        }
        else if (paged.TotalCount == 0)
        {
            <div class="alert alert-info">No users yet.</div>
        }
        else
        {
            <PaginationBar CurrentPage="currentPage" TotalPages="paged.TotalPages"
                           TotalCount="paged.TotalCount" PageSize="pageSize"
                           OnPageChanged="GoToPage" OnPageSizeChanged="ChangePageSize" />

            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in paged.Items)
                    {
                        <tr>
                            <td>@user.Name</td>
                            <td>@user.Email</td>
                            <td>@(user.Role == "Customer" ? "Regular User" : "Restaurant Owner")</td>
                            <td>
                                @if (user.IsBlocked)
                                {
                                    <span class="badge bg-danger">Blocked</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                            </td>
                            <td class="text-end">
                                @if (user.IsBlocked)
                                {
                                    <button class="btn btn-sm btn-outline-success"
                                            disabled="@busy"
                                            @onclick="() => Unblock(user.Id)">
                                        Unblock
                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-outline-danger"
                                            disabled="@busy"
                                            @onclick="() => Block(user.Id)">
                                        Block
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@code {
    private readonly CreateUserModel model = new();
    private PagedResult<UserDto>? paged;
    private string? error;
    private string? successMessage;
    private bool busy;
    private int currentPage = 1;
    private int pageSize = 10;

    protected override async Task OnInitializedAsync()
    {
        await LoadPageAsync();
    }

    private async Task LoadPageAsync()
    {
        paged = await Users.GetPageAsync(currentPage, pageSize);
    }

    private async Task GoToPage(int page)
    {
        if (paged is null || page < 1 || page > paged.TotalPages) return;
        currentPage = page;
        await LoadPageAsync();
    }

    private async Task ChangePageSize(int size)
    {
        pageSize = size;
        currentPage = 1;
        await LoadPageAsync();
    }

    private async Task AutoDismissToastAsync()
    {
        await Task.Delay(5000);
        successMessage = null;
        await InvokeAsync(StateHasChanged);
    }

    private async Task CreateUser()
    {
        busy = true;
        error = null;

        var request = new CreateUserRequest(model.Name, model.Email, model.Password, model.Role);
        var (success, _, err) = await Users.CreateAsync(request);

        if (success)
        {
            var createdName = model.Name;
            model.Reset();
            await LoadPageAsync();
            successMessage = $"User \"{createdName}\" was created successfully.";
            _ = AutoDismissToastAsync();
        }
        else
        {
            error = err;
        }

        busy = false;
    }

    private async Task Block(int userId)
    {
        busy = true;
        error = null;
        var (success, err) = await Users.BlockAsync(userId);
        if (success)
            await LoadPageAsync();
        else
            error = err;
        busy = false;
    }

    private async Task Unblock(int userId)
    {
        busy = true;
        error = null;
        var (success, err) = await Users.UnblockAsync(userId);
        if (success)
            await LoadPageAsync();
        else
            error = err;
        busy = false;
    }

    private class CreateUserModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = ValidationMessages.NameRequired)]
        [System.ComponentModel.DataAnnotations.MaxLength(100, ErrorMessage = ValidationMessages.NameTooLong)]
        public string Name { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = ValidationMessages.EmailRequired)]
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = ValidationMessages.EmailInvalid)]
        [System.ComponentModel.DataAnnotations.MaxLength(255, ErrorMessage = ValidationMessages.EmailTooLong)]
        public string Email { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = ValidationMessages.PasswordRequired)]
        [System.ComponentModel.DataAnnotations.MinLength(6, ErrorMessage = ValidationMessages.PasswordTooShort)]
        [System.ComponentModel.DataAnnotations.MaxLength(100, ErrorMessage = ValidationMessages.PasswordTooLong)]
        public string Password { get; set; } = "";

        public string Role { get; set; } = "Customer";

        public void Reset()
        {
            Name = "";
            Email = "";
            Password = "";
            Role = "Customer";
        }
    }
}
