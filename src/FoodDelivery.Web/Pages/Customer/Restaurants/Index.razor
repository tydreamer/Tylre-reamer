@page "/restaurants"
@attribute [Authorize(Roles = "Customer")]
@inject RestaurantService Restaurants
@inject PaginatedPageLoadService PageLoad

<PageTitle>Food Delivery</PageTitle>

<h1 class="mb-4">Restaurants</h1>

<BrowseToolbar>
    <BrowseSearchBar @bind-SearchTerm="searchTerm" OnSearch="ApplyFiltersAsync"
                     Placeholder="Search by name, description, or cuisine..." />
    @if (cuisineFilterOptions.Count > 0)
    {
        <BrowseMultiFilter Label="Cuisine" EmptySummary="All cuisines"
                           Options="cuisineFilterOptions"
                           SelectedIds="selectedCuisineIds"
                           SelectedIdsChanged="OnCuisineFilterChangedAsync" />
    }
</BrowseToolbar>

@if (paged is null)
{
    <p><em>Loading...</em></p>
}
else if (paged.TotalCount == 0)
{
    <div class="alert alert-info">
        @(HasActiveFilters ? "No restaurants match your search or filters." : "No restaurants available yet.")
    </div>
}
else
{
    <PaginatedPageContent>
    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
        @foreach (var restaurant in paged.Items)
        {
            <div class="col">
                <a href="restaurants/@restaurant.Id" class="text-decoration-none text-dark">
                    <div class="card h-100 shadow-sm restaurant-card meal-browse-card">
                        <RestaurantCardImage Name="@restaurant.Name" ImageUrl="@restaurant.ImageUrl" />
                        <div class="card-body">
                            <div class="meal-card-title-row mb-1">
                                <h5 class="card-title mb-0 meal-card-truncate" title="@restaurant.Name">@restaurant.Name</h5>
                                <span class="badge meal-type-badge">@restaurant.CuisineName</span>
                            </div>
                            <p class="card-text meal-card-line" title="@restaurant.Description">@restaurant.Description</p>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
    </PaginatedPageContent>

    <PaginationBar CurrentPage="@currentPage" TotalPages="paged.TotalPages"
                   TotalCount="paged.TotalCount" PageSize="@pageSize"
                   PageSizeOptions="BrowsePageSizeOptions"
                   OnPageChanged="GoToPage" OnPageSizeChanged="ChangePageSize" />
}

@code {
    private PagedResult<RestaurantDto>? paged;
    private int currentPage = 1;
    private int pageSize = 12;
    private string searchTerm = "";
    private HashSet<int> selectedCuisineIds = [];
    private IReadOnlyList<BrowseFilterOption> cuisineFilterOptions = [];
    private static readonly int[] BrowsePageSizeOptions = [12, 24, 48];

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(searchTerm) || selectedCuisineIds.Count > 0;

    protected override async Task OnInitializedAsync()
    {
        var cuisines = await Restaurants.GetCuisinesAsync();
        cuisineFilterOptions = cuisines
            .Select(c => new BrowseFilterOption(c.Id, c.Name))
            .ToList();
        await LoadPageAsync();
    }

    private async Task ApplyFiltersAsync()
    {
        currentPage = 1;
        await LoadPageAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnCuisineFilterChangedAsync(IReadOnlyCollection<int> ids)
    {
        selectedCuisineIds = ids.ToHashSet();
        await ApplyFiltersAsync();
    }

    private async Task LoadPageAsync()
    {
        IEnumerable<int>? cuisineIds = selectedCuisineIds.Count > 0 ? selectedCuisineIds : null;
        paged = null;
        await InvokeAsync(StateHasChanged);

        paged = await Restaurants.GetPageAsync(
            currentPage, pageSize, search: searchTerm, cuisineIds: cuisineIds);
    }

    private async Task GoToPage(int page)
    {
        if (paged is null || page < 1 || page > paged.TotalPages) return;
        await PageLoad.NavigateAsync(async () =>
        {
            currentPage = page;
            await LoadPageAsync();
        });
        await InvokeAsync(StateHasChanged);
    }

    private async Task ChangePageSize(int size)
    {
        await PageLoad.NavigateAsync(async () =>
        {
            pageSize = size;
            currentPage = 1;
            await LoadPageAsync();
        });
        await InvokeAsync(StateHasChanged);
    }
}
