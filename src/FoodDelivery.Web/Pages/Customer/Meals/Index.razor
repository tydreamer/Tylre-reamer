@page "/meals"
@attribute [Authorize(Roles = "Customer")]
@inject MealService Meals
@inject CartService Cart
@inject ToastService Toast
@inject PaginatedPageLoadService PageLoad

<PageTitle>Meals</PageTitle>

<h1 class="mb-4">Meals</h1>

<BrowseSearchBar @bind-SearchTerm="searchTerm" OnSearch="ApplySearchAsync" />

@if (paged is null)
{
    <p><em>Loading...</em></p>
}
else if (paged.TotalCount == 0)
{
    <div class="alert alert-info">
        @(HasActiveSearch ? "No meals match your search." : "No meals available yet.")
    </div>
}
else
{
    <PaginatedPageContent>
    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
        @foreach (var meal in paged.Items)
        {
            <div class="col">
                <div class="card h-100 shadow-sm meal-browse-card">
                    <a href="meals/@meal.Id" class="text-decoration-none text-dark">
                        <div class="meal-card-thumb">
                            @if (!string.IsNullOrWhiteSpace(meal.ImageUrl))
                            {
                                <img src="@meal.ImageUrl" class="meal-card-thumb-img" alt="@meal.Name" />
                            }
                            <span class="badge meal-restaurant-badge meal-card-truncate" title="@meal.RestaurantName">@meal.RestaurantName</span>
                        </div>
                        <div class="card-body pb-2">
                            <div class="meal-card-title-row mb-1">
                                <h5 class="card-title mb-0 meal-card-truncate" title="@meal.Name">@meal.Name</h5>
                                <span class="badge meal-type-badge">@meal.MealTypeName</span>
                            </div>
                            <p class="text-muted small meal-card-line" title="@meal.Description">@meal.Description</p>
                        </div>
                    </a>
                    <div class="card-body pt-0">
                        <div class="meal-card-price-row">
                            <div class="meal-card-price-start">
                                <span class="badge bg-success fs-6">@meal.Price.ToString("C")</span>
                                @if (!meal.IsAvailable)
                                {
                                    <span class="badge bg-secondary">Unavailable</span>
                                }
                            </div>
                            @if (meal.IsAvailable)
                            {
                                <div class="meal-card-cart">
                                    <div class="d-inline-flex align-items-center gap-1" role="group" aria-label="Quantity for @meal.Name">
                                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                                disabled="@(GetQuantity(meal.Id) <= 1 || addingMealId == meal.Id)"
                                                @onclick="() => DecreaseQuantity(meal.Id)">−</button>
                                        <span class="cart-qty-display">@GetQuantity(meal.Id)</span>
                                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                                disabled="@(addingMealId == meal.Id)"
                                                @onclick="() => IncreaseQuantity(meal.Id)">+</button>
                                    </div>
                                    <button type="button" class="btn btn-sm btn-primary"
                                            disabled="@(addingMealId == meal.Id)"
                                            @onclick="() => RequestAddToCart(meal)">
                                        @(addingMealId == meal.Id ? "Adding..." : "Add to cart")
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
    </PaginatedPageContent>

    <PaginationBar CurrentPage="currentPage" TotalPages="paged.TotalPages"
                   TotalCount="paged.TotalCount" PageSize="pageSize"
                   PageSizeOptions="BrowsePageSizeOptions"
                   OnPageChanged="GoToPage" OnPageSizeChanged="ChangePageSize" />
}

<ConfirmDialog @bind-IsVisible="showSwitchRestaurantDialog"
               Title="Replace cart items?"
               Message="@switchRestaurantDialogMessage"
               ConfirmText="Replace cart"
               CancelText="Keep current cart"
               ConfirmButtonClass="btn-danger"
               OnConfirmed="SwitchRestaurantConfirmedAsync" />

@code {
    private PagedResult<MealBrowseDto>? paged;
    private int currentPage = 1;
    private int pageSize = 12;
    private string searchTerm = "";
    private static readonly int[] BrowsePageSizeOptions = [12, 24, 48];
    private readonly Dictionary<int, int> quantities = new();
    private int? addingMealId;
    private bool showSwitchRestaurantDialog;
    private MealBrowseDto? pendingMeal;
    private int pendingQuantity;
    private string switchRestaurantDialogMessage = "";

    private bool HasActiveSearch => !string.IsNullOrWhiteSpace(searchTerm);

    protected override async Task OnInitializedAsync()
    {
        await Cart.InitializeAsync();
        await LoadPageAsync();
    }

    private int GetQuantity(int mealId) =>
        quantities.TryGetValue(mealId, out var qty) ? qty : 1;

    private void IncreaseQuantity(int mealId) =>
        quantities[mealId] = GetQuantity(mealId) + 1;

    private void DecreaseQuantity(int mealId)
    {
        if (GetQuantity(mealId) > 1)
            quantities[mealId] = GetQuantity(mealId) - 1;
    }

    private async Task RequestAddToCart(MealBrowseDto meal)
    {
        if (!meal.IsAvailable)
            return;

        var quantity = GetQuantity(meal.Id);

        if (Cart.HasItemsFromDifferentRestaurant(meal.RestaurantId))
        {
            pendingMeal = meal;
            pendingQuantity = quantity;
            switchRestaurantDialogMessage =
                $"Your cart has items from {Cart.RestaurantName}. Replace them with meals from {meal.RestaurantName}?";
            showSwitchRestaurantDialog = true;
            return;
        }

        await AddToCartAsync(meal, quantity);
    }

    private async Task SwitchRestaurantConfirmedAsync()
    {
        if (pendingMeal is null)
            return;

        var meal = pendingMeal;
        var quantity = pendingQuantity;
        pendingMeal = null;

        await Cart.ClearAsync();
        await AddToCartAsync(meal, quantity);
    }

    private async Task AddToCartAsync(MealBrowseDto meal, int quantity)
    {
        addingMealId = meal.Id;
        try
        {
            await Cart.AddAsync(ToMealDto(meal), meal.RestaurantName, quantity);
            quantities[meal.Id] = 1;
            var message = quantity == 1
                ? $"Added {meal.Name} to your cart."
                : $"Added {quantity} × {meal.Name} to your cart.";
            Toast.ShowSuccess(message);
        }
        finally
        {
            addingMealId = null;
        }
    }

    private static MealDto ToMealDto(MealBrowseDto meal) =>
        new(meal.Id, meal.Name, meal.Description, meal.ImageUrl, meal.Price,
            meal.IsAvailable, meal.RestaurantId, meal.MealTypeId, meal.MealTypeName);

    private async Task ApplySearchAsync()
    {
        currentPage = 1;
        await LoadPageAsync();
    }

    private async Task LoadPageAsync()
    {
        paged = await Meals.GetPageAsync(currentPage, pageSize, searchTerm);
    }

    private async Task GoToPage(int page)
    {
        if (paged is null || page < 1 || page > paged.TotalPages) return;
        await PageLoad.NavigateAsync(async () =>
        {
            currentPage = page;
            await LoadPageAsync();
        });
        await InvokeAsync(StateHasChanged);
    }

    private async Task ChangePageSize(int size)
    {
        await PageLoad.NavigateAsync(async () =>
        {
            pageSize = size;
            currentPage = 1;
            await LoadPageAsync();
        });
        await InvokeAsync(StateHasChanged);
    }
}
