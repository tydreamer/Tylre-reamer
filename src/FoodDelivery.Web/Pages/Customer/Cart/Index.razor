@page "/cart"
@attribute [Authorize(Roles = "Customer")]
@implements IDisposable
@inject CartService Cart
@inject OrderService Orders
@inject CouponService Coupons

<PageTitle>Your Cart</PageTitle>

<h1 class="mb-4">Your Cart</h1>

@if (placedOrder is not null)
{
    <div class="alert alert-success">
        <h5 class="alert-heading">Order placed!</h5>
        <p class="mb-1">Your order <strong>#@placedOrder.Id</strong> has been placed.</p>
        <p class="mb-0">Total charged: <strong>@placedOrder.TotalPrice.ToString("C")</strong></p>
    </div>
    <div class="d-flex flex-column flex-sm-row flex-wrap gap-2">
        <a href="/orders/@placedOrder.Id" class="btn btn-primary">View order</a>
        <a href="/restaurants" class="btn btn-outline-secondary">Back to restaurants</a>
    </div>
}
else if (Cart.IsEmpty)
{
    <div class="alert alert-info">Your cart is empty.</div>
    <a href="/restaurants" class="btn btn-primary">Browse restaurants</a>
}
else
{
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <p class="text-muted mb-0">Ordering from <strong>@Cart.RestaurantName</strong></p>
        <button type="button" class="btn btn-outline-danger btn-sm" @onclick="() => showClearDialog = true">
            Clear cart
        </button>
    </div>

    <div class="row g-4">
        <div class="col-md-7">
            <div class="d-md-none vstack gap-3 mb-3 mb-md-0">
                @foreach (var item in Cart.Items)
                {
                    <CartItemCard Item="@item"
                                  OnDecrease="@(() => DecreaseQuantity(item.Meal.Id, item.Quantity))"
                                  OnIncrease="@(() => IncreaseQuantity(item.Meal.Id, item.Quantity))"
                                  OnRemove="@(() => RemoveItem(item.Meal.Id))" />
                }
            </div>

            <CartItemsTable Items="Cart.Items"
                            OnDecrease="DecreaseQuantityById"
                            OnIncrease="IncreaseQuantityById"
                            OnRemove="RemoveItem" />
        </div>

        <div class="col-md-5">
            <CartCheckoutPanel CouponCode="@couponCode"
                               OnCouponInput="OnCouponInput"
                               OnCouponFieldFinished="OnCouponFieldFinishedAsync"
                               OnCouponKeyDown="OnCouponKeyDownAsync"
                               ValidatingCoupon="@validatingCoupon"
                               Tip="@tip"
                               OnTipInput="OnTipInput"
                               CouponSuccessMessage="@couponSuccessMessage"
                               CouponError="@couponError"
                               HasAppliedCoupon="@HasAppliedCoupon"
                               OriginalTotal="@OriginalTotal"
                               FinalTotal="@FinalTotal"
                               CheckoutError="@checkoutError"
                               Placing="@placing"
                               OnCheckout="CheckoutAsync" />
        </div>
    </div>

    <ConfirmDialog @bind-IsVisible="showClearDialog"
                   Title="Clear cart"
                   Message="Remove all items from your cart? This cannot be undone."
                   ConfirmText="Clear cart"
                   CancelText="Keep items"
                   ConfirmButtonClass="btn-danger"
                   OnConfirmed="ClearCartConfirmedAsync" />
}

@code {
    private decimal tip;
    private string? couponCode;
    private string? appliedCouponCode;
    private string? couponSuccessMessage;
    private string? couponError;
    private decimal couponDiscount;
    private string? checkoutError;
    private bool placing;
    private bool validatingCoupon;
    private bool showClearDialog;
    private OrderResponse? placedOrder;
    private string? lastValidatedCouponInput;

    private decimal Subtotal => Cart.Subtotal;
    private bool HasAppliedCoupon => !string.IsNullOrWhiteSpace(appliedCouponCode) && couponDiscount > 0;
    private decimal OriginalTotal => Subtotal + tip;
    private decimal FinalTotal => Math.Max(0, Subtotal - couponDiscount) + tip;

    protected override async Task OnInitializedAsync()
    {
        await Cart.InitializeAsync();
        Cart.OnChange += OnCartChanged;
    }

    private void OnCartChanged() => _ = HandleCartChangedAsync();

    private async Task HandleCartChangedAsync()
    {
        if (Cart.IsEmpty)
        {
            ClearCouponState();
            couponCode = null;
        }
        else if (HasAppliedCoupon || !string.IsNullOrWhiteSpace(couponCode))
        {
            await ValidateCouponAsync();
        }

        await InvokeAsync(StateHasChanged);
    }

    private Task DecreaseQuantityById(int mealId)
    {
        var item = Cart.Items.FirstOrDefault(i => i.Meal.Id == mealId);
        return item is null ? Task.CompletedTask : DecreaseQuantity(mealId, item.Quantity);
    }

    private Task IncreaseQuantityById(int mealId)
    {
        var item = Cart.Items.FirstOrDefault(i => i.Meal.Id == mealId);
        return item is null ? Task.CompletedTask : IncreaseQuantity(mealId, item.Quantity);
    }

    private Task DecreaseQuantity(int mealId, int quantity)
    {
        if (quantity <= 1)
            return Task.CompletedTask;

        return Cart.SetQuantityAsync(mealId, quantity - 1);
    }

    private Task IncreaseQuantity(int mealId, int quantity) =>
        Cart.SetQuantityAsync(mealId, quantity + 1);

    private async Task RemoveItem(int mealId) => await Cart.RemoveAsync(mealId);

    private void OnTipInput(ChangeEventArgs e) =>
        tip = decimal.TryParse(e.Value?.ToString(), out var value) ? Math.Max(0, value) : 0;

    private async Task ClearCartConfirmedAsync()
    {
        await Cart.ClearAsync();
        tip = 0;
        couponCode = null;
        lastValidatedCouponInput = null;
        ClearCouponState();
        checkoutError = null;
    }

    private void OnCouponInput(ChangeEventArgs e)
    {
        couponCode = e.Value?.ToString() ?? "";
        var trimmed = couponCode.Trim();

        if (string.IsNullOrWhiteSpace(trimmed))
        {
            lastValidatedCouponInput = null;
            ClearCouponState();
            return;
        }

        if (!string.Equals(trimmed, appliedCouponCode, StringComparison.OrdinalIgnoreCase))
        {
            lastValidatedCouponInput = null;
            ClearCouponState();
        }
    }

    private async Task OnCouponFieldFinishedAsync() => await ValidateCouponIfChangedAsync();

    private async Task OnCouponKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await ValidateCouponIfChangedAsync();
    }

    private async Task ValidateCouponIfChangedAsync()
    {
        var trimmed = couponCode?.Trim() ?? "";
        if (trimmed == lastValidatedCouponInput)
            return;

        lastValidatedCouponInput = trimmed;

        if (string.IsNullOrWhiteSpace(trimmed))
        {
            ClearCouponState();
            return;
        }

        await ValidateCouponAsync();
    }

    private async Task ValidateCouponAsync()
    {
        checkoutError = null;
        couponError = null;
        couponSuccessMessage = null;
        appliedCouponCode = null;
        couponDiscount = 0;

        if (Cart.RestaurantId is null || string.IsNullOrWhiteSpace(couponCode))
            return;

        validatingCoupon = true;
        var validation = await Coupons.ValidateAsync(
            Cart.RestaurantId.Value,
            couponCode,
            Subtotal);
        validatingCoupon = false;

        if (validation is null)
        {
            couponError = "Unable to validate coupon. Please try again.";
            return;
        }

        if (!validation.IsValid)
        {
            couponError = validation.ErrorMessage ?? "Invalid coupon.";
            return;
        }

        appliedCouponCode = couponCode.Trim();
        couponSuccessMessage = validation.SuccessMessage;
        couponDiscount = validation.DiscountAmount;
    }

    private void ClearCouponState()
    {
        appliedCouponCode = null;
        couponSuccessMessage = null;
        couponError = null;
        couponDiscount = 0;
    }

    private async Task CheckoutAsync()
    {
        if (Cart.RestaurantId is null)
            return;

        checkoutError = null;

        if (!string.IsNullOrWhiteSpace(couponCode))
        {
            lastValidatedCouponInput = null;
            await ValidateCouponIfChangedAsync();
            if (!HasAppliedCoupon)
                return;
        }

        placing = true;

        var request = new PlaceOrderRequest(
            Cart.RestaurantId.Value,
            Cart.Items.Select(i => new OrderItemRequest(i.Meal.Id, i.Quantity)).ToList(),
            tip,
            HasAppliedCoupon ? appliedCouponCode : null);

        var (success, order, err) = await Orders.PlaceOrderAsync(request);
        placing = false;

        if (success)
        {
            placedOrder = order;
            await Cart.ClearAsync();
            ClearCouponState();
            couponCode = null;
            tip = 0;
        }
        else
        {
            checkoutError = err;
        }
    }

    public void Dispose()
    {
        Cart.OnChange -= OnCartChanged;
    }
}
