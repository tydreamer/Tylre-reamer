@page "/orders"
@attribute [Authorize(Roles = "Customer")]
@implements IDisposable
@inject OrderService Orders
@inject OrderNotificationService Notifications
@inject PaginatedPageLoadService PageLoad
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>My Orders</PageTitle>

<h1 class="mb-4">My Orders</h1>

@if (paged is null)
{
    <p><em>Loading...</em></p>
}
else if (paged.TotalCount == 0)
{
    <EmptyState Icon="bi bi-receipt" Title="No orders yet"
                Message="When you place an order, it will show up here.">
        <a href="/restaurants" class="btn btn-primary">Browse restaurants</a>
    </EmptyState>
}
else
{
    <PaginatedPageContent>
    <div class="table-responsive">
        <table class="table align-middle mb-0 orders-list-table orders-list-table--customer">
            <colgroup>
                <col class="col-id" />
                <col class="col-restaurant" />
                <col class="col-items" />
                <col class="col-date" />
                <col class="col-total" />
                <col class="col-status" />
            </colgroup>
            <thead>
                <tr>
                    <SortableTableHeader ColumnKey="id" Label="ID" Class="col-id"
                                         CurrentSortBy="@sortBy" SortDesc="@sortDesc" OnSortChanged="ChangeSortAsync" />
                    <SortableTableHeader ColumnKey="restaurant" Label="Restaurant" Class="col-restaurant"
                                         CurrentSortBy="@sortBy" SortDesc="@sortDesc" OnSortChanged="ChangeSortAsync" />
                    <SortableTableHeader ColumnKey="items" Label="Items" Class="col-items"
                                         CurrentSortBy="@sortBy" SortDesc="@sortDesc" OnSortChanged="ChangeSortAsync" />
                    <SortableTableHeader ColumnKey="date" Label="Order Date" Class="col-date"
                                         CurrentSortBy="@sortBy" SortDesc="@sortDesc" OnSortChanged="ChangeSortAsync" />
                    <SortableTableHeader ColumnKey="total" Label="Total" Class="col-total text-end"
                                         CurrentSortBy="@sortBy" SortDesc="@sortDesc" OnSortChanged="ChangeSortAsync" />
                    <SortableTableHeader ColumnKey="status" Label="Status" Class="col-status text-center"
                                         CurrentSortBy="@sortBy" SortDesc="@sortDesc" OnSortChanged="ChangeSortAsync" />
                </tr>
            </thead>
            <tbody>
                @foreach (var order in paged.Items)
                {
                    <tr class="orders-list-row"
                        role="button"
                        tabindex="0"
                        aria-label="@($"View order #{order.Id}")"
                        @onmousedown="e => RowNav.OnPointerDown(e, order.Id)"
                        @onmouseup="e => RowNav.OnPointerUpAsync(e, NavigateToOrder)"
                        @onkeydown="e => OnRowKeyDown(e, order.Id)">
                        <td>#@order.Id</td>
                        <td>@order.RestaurantName</td>
                        @{
                            var itemsDisplay = OrderItemsFormatter.FormatForDisplay(order.Items);
                        }
                        <td title="@itemsDisplay.Full">@itemsDisplay.Display</td>
                        <td class="text-nowrap">@order.CreatedAt.ToLocalTime().ToString("g")</td>
                        <td class="col-total text-end text-nowrap">@order.TotalPrice.ToString("C")</td>
                        <td class="col-status"><span class="badge @StatusClass(order.Status)">@order.Status</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    </PaginatedPageContent>

    <PaginationBar CurrentPage="@currentPage" TotalPages="paged.TotalPages"
                   TotalCount="paged.TotalCount" PageSize="@pageSize"
                   OnPageChanged="GoToPage" OnPageSizeChanged="ChangePageSize" />
}

@code {
    private PagedResult<OrderResponse>? paged;
    private int currentPage = 1;
    private int pageSize = 20;
    private string sortBy = "date";
    private bool sortDesc = true;
    private ClickableRowNavigator RowNav = null!;

    protected override void OnInitialized() =>
        RowNav = new ClickableRowNavigator(JS);

    protected override async Task OnInitializedAsync()
    {
        await LoadPageAsync();
        Notifications.OnOrderStatusChanged += HandleOrderChanged;
    }

    private async Task LoadPageAsync()
    {
        paged = await Orders.GetMyOrdersAsync(currentPage, pageSize, sortBy, sortDesc);
    }

    private void NavigateToOrder(int orderId) => Navigation.NavigateTo($"orders/{orderId}");

    private void OnRowKeyDown(KeyboardEventArgs e, int orderId)
    {
        if (e.Key is "Enter" or " ")
            NavigateToOrder(orderId);
    }

    private async Task ChangeSortAsync((string SortBy, bool SortDesc) sort)
    {
        sortBy = sort.SortBy;
        sortDesc = sort.SortDesc;
        currentPage = 1;
        await LoadPageAsync();
    }

    private async Task GoToPage(int page)
    {
        if (paged is null || page < 1 || page > paged.TotalPages) return;
        await PageLoad.NavigateAsync(async () =>
        {
            currentPage = page;
            await LoadPageAsync();
        });
        await InvokeAsync(StateHasChanged);
    }

    private async Task ChangePageSize(int size)
    {
        await PageLoad.NavigateAsync(async () =>
        {
            pageSize = size;
            currentPage = 1;
            await LoadPageAsync();
        });
        await InvokeAsync(StateHasChanged);
    }

    private void HandleOrderChanged(OrderStatusNotification notification)
    {
        _ = RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        paged = await Orders.GetMyOrdersAsync(currentPage, pageSize, sortBy, sortDesc);
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Notifications.OnOrderStatusChanged -= HandleOrderChanged;
    }

    private static string StatusClass(string status) => status switch
    {
        "Placed" => "bg-secondary",
        "Processing" => "bg-info",
        "InRoute" => "bg-warning text-dark",
        "Delivered" => "bg-primary",
        "Received" => "bg-success",
        "Cancelled" => "bg-danger",
        _ => "bg-secondary"
    };
}
