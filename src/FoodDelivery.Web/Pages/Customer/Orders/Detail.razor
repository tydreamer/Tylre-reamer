@page "/orders/{Id:int}"
@attribute [Authorize(Roles = "Customer")]
@implements IDisposable
@inject OrderService Orders
@inject MealService Meals
@inject CartService Cart
@inject OrderNotificationService Notifications
@inject NavigationManager Navigation

@if (order is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <PageTitle>Order #@order.Id</PageTitle>

    <div class="mb-4">
        <a href="orders" class="btn btn-link ps-0">&larr; Back to my orders</a>
        <div class="page-header mb-2">
            <h1 class="mb-0">Order #@order.Id</h1>
            <span class="badge fs-6 @StatusClass(order.Status) align-self-start">@order.Status</span>
        </div>
        <p class="text-muted mb-0">@order.RestaurantName · Ordered at @order.CreatedAt.ToLocalTime().ToString("f")</p>
    </div>

    <div class="row">
        <div class="col-md-7">
            <h5>Items</h5>
            <div class="table-responsive">
                <table class="table mb-0">
                    <thead>
                        <tr>
                            <th>Meal</th>
                            <th class="text-center">Qty</th>
                            <th class="text-end">Unit</th>
                            <th class="text-end">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in order.Items)
                        {
                            <tr>
                                <td>@item.MealName</td>
                                <td class="text-center">@item.Quantity</td>
                                <td class="text-end text-nowrap">@item.UnitPrice.ToString("C")</td>
                                <td class="text-end text-nowrap">@((item.UnitPrice * item.Quantity).ToString("C"))</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="3" class="text-end">Tip</td>
                            <td class="text-end text-nowrap">@order.Tip.ToString("C")</td>
                        </tr>
                        <tr class="fw-bold">
                            <td colspan="3" class="text-end">Total</td>
                            <td class="text-end text-nowrap">@order.TotalPrice.ToString("C")</td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            @if (error is not null)
            {
                <div class="alert alert-danger">@error</div>
            }

            <div class="d-flex flex-wrap gap-2 mt-3">
                @if (CanCancel(order.Status))
                {
                    <button class="btn btn-outline-danger" @onclick="() => showCancelDialog = true" disabled="@busy">Cancel order</button>
                }
                @if (order.Status == "Delivered")
                {
                    <button class="btn btn-success" @onclick="MarkReceived" disabled="@busy">Mark as received</button>
                }
                <button class="btn btn-primary" @onclick="Reorder" disabled="@busy">Reorder</button>
            </div>
        </div>

        <div class="col-md-5">
            <h5>Status history</h5>
            <div class="table-responsive">
                <table class="table mb-0">
                    <thead>
                        <tr>
                            <th>Status</th>
                            <th class="text-end">Time</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in order.StatusHistory)
                        {
                            <tr>
                                <td><span class="badge @StatusClass(entry.Status)">@entry.Status</span></td>
                                <td class="text-end text-muted text-nowrap">@entry.ChangedAt.ToLocalTime().ToString("g")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <ConfirmDialog @bind-IsVisible="showCancelDialog"
                   Title="Cancel order"
                   Message="Are you sure you want to cancel this order? This cannot be undone."
                   ConfirmText="Cancel order"
                   CancelText="Keep order"
                   ConfirmButtonClass="btn-danger"
                   OnConfirmed="CancelConfirmedAsync" />
}

@code {
    [Parameter]
    public int Id { get; set; }

    private OrderResponse? order;
    private string? error;
    private bool busy;
    private bool showCancelDialog;

    protected override async Task OnInitializedAsync()
    {
        await Cart.InitializeAsync();
        await RefreshOrderAsync();
        Notifications.OnOrderStatusChanged += HandleStatusChanged;
    }

    private void HandleStatusChanged(OrderStatusNotification notification)
    {
        if (notification.OrderId == Id)
            _ = RefreshOrderAsync();
    }

    private async Task RefreshOrderAsync()
    {
        order = await Orders.GetByIdAsync(Id);
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Notifications.OnOrderStatusChanged -= HandleStatusChanged;
    }

    private async Task CancelConfirmedAsync()
    {
        busy = true;
        error = null;
        var (success, err) = await Orders.UpdateStatusAsync(Id, "Cancelled");
        if (success)
            order = await Orders.GetByIdAsync(Id);
        else
            error = err;
        busy = false;
    }

    private async Task MarkReceived()
    {
        busy = true;
        error = null;
        var (success, err) = await Orders.UpdateStatusAsync(Id, "Received");
        if (success)
            order = await Orders.GetByIdAsync(Id);
        else
            error = err;
        busy = false;
    }

    private async Task Reorder()
    {
        if (order is null)
            return;

        busy = true;
        error = null;

        var meals = await Meals.GetByRestaurantAsync(order.RestaurantId);
        await Cart.ClearAsync();

        foreach (var item in order.Items)
        {
            var meal = meals.FirstOrDefault(m => m.Id == item.MealId);
            if (meal is null)
                continue;

            await Cart.AddAsync(meal, order.RestaurantName, item.Quantity);
        }

        busy = false;

        if (Cart.IsEmpty)
            error = "None of these meals are available to reorder.";
        else
            Navigation.NavigateTo("/cart");
    }

    private static bool CanCancel(string status) => status is "Placed";

    private static string StatusClass(string status) => status switch
    {
        "Placed" => "bg-secondary",
        "Processing" => "bg-info",
        "InRoute" => "bg-warning text-dark",
        "Delivered" => "bg-primary",
        "Received" => "bg-success",
        "Cancelled" => "bg-danger",
        _ => "bg-secondary"
    };
}
