@page "/reset-password"
@layout AuthLayout
@attribute [AllowAnonymous]
@inject AuthService Auth
@inject NavigationManager Navigation

<PageTitle>Reset Password</PageTitle>

<div class="card auth-card shadow border-0">
    <div class="card-body p-4">
        <h3 class="text-center mb-4">Reset Password</h3>

        @if (invalidToken)
        {
            <div class="alert alert-danger">Invalid or missing reset link.</div>
            <a href="/forgot-password" class="btn btn-outline-primary w-100">Request a new link</a>
        }
        else if (completed)
        {
            <div class="alert alert-success">Your password has been reset. You can sign in now.</div>
            <a href="/sign-in" class="btn btn-primary w-100">Sign In</a>
        }
        else
        {
            <EditForm Model="model" OnValidSubmit="HandleSubmit">
                <DataAnnotationsValidator />
                <div class="mb-3">
                    <label class="form-label">New password</label>
                    <InputText class="form-control" @bind-Value="model.NewPassword" type="password" />
                    <FirstValidationMessage For="() => model.NewPassword" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Confirm password</label>
                    <InputText class="form-control" @bind-Value="model.ConfirmPassword" type="password" />
                    <FirstValidationMessage For="() => model.ConfirmPassword" />
                </div>
                @if (error is not null)
                {
                    <div class="alert alert-danger mb-3">@error</div>
                }
                <button class="btn btn-primary w-100" type="submit" disabled="@loading">
                    @(loading ? "Saving..." : "Reset password")
                </button>
            </EditForm>
        }
    </div>
</div>

@code {
    private readonly ResetPasswordModel model = new();
    private string? token;
    private string? error;
    private bool loading;
    private bool completed;
    private bool invalidToken;

    protected override void OnInitialized()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        token = query["token"];

        if (string.IsNullOrWhiteSpace(token))
            invalidToken = true;
    }

    private async Task HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(token))
        {
            invalidToken = true;
            return;
        }

        if (model.NewPassword != model.ConfirmPassword)
        {
            error = "Passwords do not match.";
            return;
        }

        loading = true;
        error = null;
        var (success, err) = await Auth.ResetPasswordAsync(token, model.NewPassword);
        loading = false;

        if (!success)
        {
            error = err ?? "Unable to reset password.";
            return;
        }

        completed = true;
    }

    private class ResetPasswordModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = ValidationMessages.PasswordRequired)]
        [System.ComponentModel.DataAnnotations.MinLength(6, ErrorMessage = ValidationMessages.PasswordTooShort)]
        [System.ComponentModel.DataAnnotations.MaxLength(100, ErrorMessage = ValidationMessages.PasswordTooLong)]
        public string NewPassword { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = ValidationMessages.PasswordRequired)]
        public string ConfirmPassword { get; set; } = "";
    }
}
