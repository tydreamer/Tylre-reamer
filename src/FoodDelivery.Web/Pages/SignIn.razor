@page "/sign-in"
@attribute [AllowAnonymous]
@inject AuthService Auth
@inject NavigationManager Navigation

<div class="row justify-content-center mt-5">
    <div class="col-md-4">
        <h3 class="mb-4">Sign In</h3>

        @if (registered)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                Account created successfully. Sign in to continue.
                <button type="button" class="btn-close" @onclick="() => registered = false"></button>
            </div>
        }

        <EditForm Model="model" OnValidSubmit="HandleSignIn">
            <DataAnnotationsValidator />
            <div class="mb-3">
                <label class="form-label">Email</label>
                <InputText class="form-control" @bind-Value="model.Email" type="email" />
                <ValidationMessage For="() => model.Email" />
            </div>
            <div class="mb-3">
                <label class="form-label">Password</label>
                <InputText class="form-control" @bind-Value="model.Password" type="password" />
                <ValidationMessage For="() => model.Password" />
            </div>
            @if (error is not null)
            {
                <div class="alert alert-danger">@error</div>
            }
            <button class="btn btn-primary w-100" type="submit" disabled="@loading">
                @(loading ? "Signing in..." : "Sign In")
            </button>
        </EditForm>
        <p class="mt-3 text-center">
            Don't have an account? <a href="/sign-up">Sign Up</a>
        </p>
    </div>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private readonly SignInModel model = new();
    private string? error;
    private bool loading;
    private bool registered;

    protected override async Task OnInitializedAsync()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        registered = query["registered"] == "true";

        if (AuthStateTask is not null)
        {
            var state = await AuthStateTask;
            if (state.User.Identity?.IsAuthenticated == true)
                Navigation.NavigateTo(LandingPath(state.User.IsInRole("Admin") ? "Admin" : ""), replace: true);
        }
    }

    private async Task HandleSignIn()
    {
        loading = true;
        error = null;
        var role = await Auth.LoginAsync(model.Email, model.Password);
        loading = false;

        if (role is null)
            error = "Invalid email or password.";
        else
            Navigation.NavigateTo(LandingPath(role));
    }

    private static string LandingPath(string role) => role == "Admin" ? "/admin/users" : "/";

    private class SignInModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.EmailAddress]
        public string Email { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required]
        public string Password { get; set; } = "";
    }
}
