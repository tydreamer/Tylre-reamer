@page "/owner/orders"
@attribute [Authorize(Roles = "Owner")]
@implements IDisposable
@inject OrderService Orders
@inject OrderNotificationService Notifications

<PageTitle>Incoming Orders</PageTitle>

<h1 class="mb-4">Incoming Orders</h1>

@if (paged is null)
{
    <p><em>Loading...</em></p>
}
else if (paged.TotalCount == 0)
{
    <div class="alert alert-info">No orders yet.</div>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Restaurant</th>
                    <th>Customer</th>
                    <th>Items</th>
                    <th>Order Date</th>
                    <th class="text-end">Total</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in paged.Items)
                {
                    <tr>
                        <td>#@order.Id</td>
                        <td>@order.RestaurantName</td>
                        <td>@order.CustomerName</td>
                        @{
                            var itemsDisplay = OrderItemsFormatter.FormatForDisplay(order.Items);
                        }
                        <td class="order-items-cell" title="@itemsDisplay.Full">@itemsDisplay.Display</td>
                        <td class="text-nowrap">@order.CreatedAt.ToLocalTime().ToString("g")</td>
                        <td class="text-end text-nowrap">@order.TotalPrice.ToString("C")</td>
                        <td><span class="badge @StatusClass(order.Status)">@order.Status</span></td>
                        <td class="text-end text-nowrap">
                            <a href="owner/orders/@order.Id" class="btn btn-sm btn-outline-primary">View</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <PaginationBar CurrentPage="currentPage" TotalPages="paged.TotalPages"
                   TotalCount="paged.TotalCount" PageSize="pageSize"
                   OnPageChanged="GoToPage" OnPageSizeChanged="ChangePageSize" />
}

@code {
    private PagedResult<OrderResponse>? paged;
    private int currentPage = 1;
    private int pageSize = 10;

    protected override async Task OnInitializedAsync()
    {
        await LoadPageAsync();
        Notifications.OnOrderStatusChanged += HandleOrderChanged;
    }

    private async Task LoadPageAsync()
    {
        paged = await Orders.GetMyOrdersAsync(currentPage, pageSize);
    }

    private async Task GoToPage(int page)
    {
        if (paged is null || page < 1 || page > paged.TotalPages) return;
        currentPage = page;
        await LoadPageAsync();
    }

    private async Task ChangePageSize(int size)
    {
        pageSize = size;
        currentPage = 1;
        await LoadPageAsync();
    }

    private void HandleOrderChanged(OrderStatusNotification notification)
    {
        _ = RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        paged = await Orders.GetMyOrdersAsync(currentPage, pageSize);
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Notifications.OnOrderStatusChanged -= HandleOrderChanged;
    }

    private static string StatusClass(string status) => status switch
    {
        "Placed" => "bg-secondary",
        "Processing" => "bg-info",
        "InRoute" => "bg-warning text-dark",
        "Delivered" => "bg-primary",
        "Received" => "bg-success",
        "Cancelled" => "bg-danger",
        _ => "bg-secondary"
    };
}
