@page "/owner/orders"
@attribute [Authorize(Roles = "Owner")]
@implements IDisposable
@inject OrderService Orders
@inject OrderNotificationService Notifications

<PageTitle>Incoming Orders</PageTitle>

<h1 class="mb-4">Incoming Orders</h1>

@if (paged is null)
{
    <p><em>Loading...</em></p>
}
else if (paged.TotalCount == 0)
{
    <div class="alert alert-info">No orders yet.</div>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-2">
        <small class="text-muted">
            Showing @((currentPage - 1) * pageSize + 1)–@(Math.Min(currentPage * pageSize, paged.TotalCount)) of @paged.TotalCount orders
        </small>
        <nav>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <button class="page-link" @onclick="() => GoToPage(currentPage - 1)">‹</button>
                </li>
                @for (var p = 1; p <= paged.TotalPages; p++)
                {
                    var pageNum = p;
                    <li class="page-item @(pageNum == currentPage ? "active" : "")">
                        <button class="page-link" @onclick="() => GoToPage(pageNum)">@pageNum</button>
                    </li>
                }
                <li class="page-item @(currentPage == paged.TotalPages ? "disabled" : "")">
                    <button class="page-link" @onclick="() => GoToPage(currentPage + 1)">›</button>
                </li>
            </ul>
        </nav>
    </div>

    <table class="table align-middle">
        <thead>
            <tr>
                <th>Order</th>
                <th>Restaurant</th>
                <th>Customer</th>
                <th>Date</th>
                <th>Status</th>
                <th class="text-end">Total</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in paged.Items)
            {
                <tr>
                    <td>#@order.Id</td>
                    <td>@order.RestaurantName</td>
                    <td>@order.CustomerName</td>
                    <td>@order.CreatedAt.ToLocalTime().ToString("g")</td>
                    <td><span class="badge @StatusClass(order.Status)">@order.Status</span></td>
                    <td class="text-end">@order.TotalPrice.ToString("C")</td>
                    <td class="text-end">
                        <a href="owner/orders/@order.Id" class="btn btn-sm btn-outline-primary">View</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private PagedResult<OrderResponse>? paged;
    private int currentPage = 1;
    private const int pageSize = 10;

    protected override async Task OnInitializedAsync()
    {
        await LoadPageAsync();
        Notifications.OnOrderStatusChanged += HandleOrderChanged;
    }

    private async Task LoadPageAsync()
    {
        paged = await Orders.GetMyOrdersAsync(currentPage, pageSize);
    }

    private async Task GoToPage(int page)
    {
        if (paged is null || page < 1 || page > paged.TotalPages) return;
        currentPage = page;
        await LoadPageAsync();
    }

    private void HandleOrderChanged(OrderStatusNotification notification)
    {
        _ = RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        paged = await Orders.GetMyOrdersAsync(currentPage, pageSize);
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Notifications.OnOrderStatusChanged -= HandleOrderChanged;
    }

    private static string StatusClass(string status) => status switch
    {
        "Placed" => "bg-secondary",
        "Processing" => "bg-info",
        "InRoute" => "bg-warning text-dark",
        "Delivered" => "bg-primary",
        "Received" => "bg-success",
        "Cancelled" => "bg-danger",
        _ => "bg-secondary"
    };
}
