@page "/restaurants/{Id:int}"
@attribute [Authorize(Roles = "Customer")]
@inject RestaurantService Restaurants
@inject MealService Meals
@inject CartService Cart

@if (restaurant is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <PageTitle>@restaurant.Name</PageTitle>

    <div class="mb-4">
        <a href="/restaurants" class="btn btn-link ps-0">&larr; Back to restaurants</a>
        <h1>@restaurant.Name</h1>
        <p class="text-muted">@restaurant.Description</p>
    </div>

    @if (cartSuccessMessage is not null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @cartSuccessMessage
            <button type="button" class="btn-close" aria-label="Dismiss" @onclick="() => cartSuccessMessage = null"></button>
        </div>
    }

    <h4 class="mb-3">Menu</h4>

    @if (meals is null)
    {
        <p><em>Loading menu...</em></p>
    }
    else if (meals.Count == 0)
    {
        <div class="alert alert-info">This restaurant has no meals yet.</div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 g-3">
            @foreach (var meal in meals)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm">
                        <a href="/meals/@meal.Id" class="text-decoration-none text-dark">
                            @if (!string.IsNullOrWhiteSpace(meal.ImageUrl))
                            {
                                <img src="@meal.ImageUrl" class="card-img-top" alt="@meal.Name"
                                     style="height: 160px; object-fit: cover;" />
                            }
                            <div class="card-body pb-2">
                                <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                                    <h5 class="card-title mb-0">@meal.Name</h5>
                                    <span class="badge meal-type-badge">@meal.MealTypeName</span>
                                </div>
                                <p class="card-text text-muted mb-0">@meal.Description</p>
                            </div>
                        </a>
                        <div class="card-body pt-0">
                            <div class="meal-card-price-row">
                                <div class="d-flex flex-wrap align-items-center gap-2">
                                    <span class="badge bg-success fs-6">@meal.Price.ToString("C")</span>
                                    @if (!meal.IsAvailable)
                                    {
                                        <span class="badge bg-secondary">Unavailable</span>
                                    }
                                </div>
                                @if (meal.IsAvailable)
                                {
                                    <div class="meal-card-cart">
                                        <div class="d-inline-flex align-items-center gap-1" role="group" aria-label="Quantity for @meal.Name">
                                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                                    disabled="@(GetQuantity(meal.Id) <= 1 || addingMealId == meal.Id)"
                                                    @onclick="() => DecreaseQuantity(meal.Id)">−</button>
                                            <span class="cart-qty-display">@GetQuantity(meal.Id)</span>
                                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                                    disabled="@(addingMealId == meal.Id)"
                                                    @onclick="() => IncreaseQuantity(meal.Id)">+</button>
                                        </div>
                                        <button type="button" class="btn btn-sm btn-primary"
                                                disabled="@(addingMealId == meal.Id)"
                                                @onclick="() => RequestAddToCart(meal)">
                                            @(addingMealId == meal.Id ? "Adding..." : "Add to cart")
                                        </button>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}

<ConfirmDialog @bind-IsVisible="showSwitchRestaurantDialog"
               Title="Replace cart items?"
               Message="@switchRestaurantDialogMessage"
               ConfirmText="Replace cart"
               CancelText="Keep current cart"
               ConfirmButtonClass="btn-danger"
               OnConfirmed="SwitchRestaurantConfirmedAsync" />

@code {
    [Parameter]
    public int Id { get; set; }

    private RestaurantDto? restaurant;
    private List<MealDto>? meals;
    private readonly Dictionary<int, int> quantities = new();
    private string? cartSuccessMessage;
    private int? addingMealId;
    private bool showSwitchRestaurantDialog;
    private MealDto? pendingMeal;
    private int pendingQuantity;
    private string switchRestaurantDialogMessage = "";

    protected override async Task OnInitializedAsync()
    {
        await Cart.InitializeAsync();
        restaurant = await Restaurants.GetByIdAsync(Id);
        meals = await Meals.GetByRestaurantAsync(Id);
    }

    private int GetQuantity(int mealId) =>
        quantities.TryGetValue(mealId, out var qty) ? qty : 1;

    private void IncreaseQuantity(int mealId) =>
        quantities[mealId] = GetQuantity(mealId) + 1;

    private void DecreaseQuantity(int mealId)
    {
        if (GetQuantity(mealId) > 1)
            quantities[mealId] = GetQuantity(mealId) - 1;
    }

    private void RequestAddToCart(MealDto meal)
    {
        if (restaurant is null || !meal.IsAvailable)
            return;

        var quantity = GetQuantity(meal.Id);

        if (Cart.HasItemsFromDifferentRestaurant(Id))
        {
            pendingMeal = meal;
            pendingQuantity = quantity;
            switchRestaurantDialogMessage =
                $"Your cart has items from {Cart.RestaurantName}. Replace them with meals from {restaurant.Name}?";
            showSwitchRestaurantDialog = true;
            return;
        }

        _ = AddToCartAsync(meal, quantity);
    }

    private async Task SwitchRestaurantConfirmedAsync()
    {
        if (pendingMeal is null || restaurant is null)
            return;

        var meal = pendingMeal;
        var quantity = pendingQuantity;
        pendingMeal = null;

        await Cart.ClearAsync();
        await AddToCartAsync(meal, quantity);
    }

    private async Task AddToCartAsync(MealDto meal, int quantity)
    {
        if (restaurant is null)
            return;

        addingMealId = meal.Id;
        cartSuccessMessage = null;
        await Cart.AddAsync(meal, restaurant.Name, quantity);
        addingMealId = null;
        quantities[meal.Id] = 1;

        cartSuccessMessage = quantity == 1
            ? $"Added {meal.Name} to your cart."
            : $"Added {quantity} × {meal.Name} to your cart.";
    }
}
