@page "/owner/restaurants/{RestaurantId:int}/meals"
@attribute [Authorize(Roles = "Owner")]
@inject RestaurantService Restaurants
@inject MealService Meals
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>@(restaurant?.Name ?? "Meals")</PageTitle>


@if (error is not null)
{
    <div class="alert alert-danger">@error</div>
}

@if (restaurant is null || meals is null)
{
    <div class="mb-4">
        <a href="owner/restaurants" class="btn btn-link ps-0">&larr; Back to my restaurants</a>
        <p class="mb-0"><em>Loading...</em></p>
    </div>
}
else
{
    <div class="page-header mb-4">
        <div class="page-header-title">
            <a href="owner/restaurants" class="btn btn-link ps-0">&larr; Back to my restaurants</a>
            <h1 class="mb-0">@restaurant.Name — Meals</h1>
        </div>
        <a href="owner/restaurants/@RestaurantId/meals/new" class="btn btn-primary">Add Meal</a>
    </div>

    @if (meals.Count == 0)
    {
        <EmptyState Icon="bi bi-fork-knife" Message="This restaurant has no meals yet.">
            <a href="owner/restaurants/@RestaurantId/meals/new" class="btn btn-primary">Add meal</a>
        </EmptyState>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0 meals-list-table">
                <colgroup>
                    <col class="col-meal" />
                    <col class="col-description" />
                    <col class="col-price" />
                    <col class="col-type" />
                    <col class="col-actions" />
                </colgroup>
                <thead>
                    <tr>
                        <th>Meal</th>
                        <th>Description</th>
                        <th class="text-end">Price</th>
                        <th>Type</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var meal in meals)
                    {
                        <tr>
                            <td title="@meal.Name">@meal.Name</td>
                            <td title="@meal.Description">@meal.Description</td>
                            <td class="text-end text-nowrap">@meal.Price.ToString("C")</td>
                            <td>@meal.MealTypeName</td>
                            <td class="col-actions text-end text-nowrap">
                                <div class="table-row-actions">
                                    <a href="owner/restaurants/@RestaurantId/meals/@meal.Id/edit"
                                       class="btn btn-sm btn-outline-primary table-icon-btn"
                                       title="Edit"
                                       aria-label="@($"Edit {meal.Name}")">
                                        <i class="bi bi-pencil" aria-hidden="true"></i>
                                    </a>
                                    <button type="button"
                                            class="btn btn-sm btn-outline-danger table-icon-btn"
                                            title="Remove"
                                            aria-label="@($"Remove {meal.Name}")"
                                            disabled="@(removingId == meal.Id)"
                                            @onclick="() => RequestRemove(meal)">
                                        @if (removingId == meal.Id)
                                        {
                                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                        }
                                        else
                                        {
                                            <i class="bi bi-trash" aria-hidden="true"></i>
                                        }
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

<ConfirmDialog @bind-IsVisible="showRemoveDialog"
               Title="Remove meal"
               Message="@removeDialogMessage"
               ConfirmText="Remove"
               CancelText="Cancel"
               ConfirmButtonClass="btn-danger"
               OnConfirmed="RemoveConfirmedAsync" />

@code {
    [Parameter] public int RestaurantId { get; set; }

    private RestaurantDto? restaurant;
    private List<MealDto>? meals;
    private string? error;
    private int? removingId;
    private bool showRemoveDialog;
    private int? pendingRemoveMealId;
    private string removeDialogMessage = "";

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthStateProvider.GetAuthenticationStateAsync()).User;
        var ownerId = user.GetUserId();
        if (ownerId is null)
        {
            error = "Unable to determine your account. Please sign in again.";
            return;
        }

        restaurant = await Restaurants.GetByIdAsync(RestaurantId);
        if (restaurant is null)
        {
            error = "Restaurant not found.";
            return;
        }

        if (restaurant.OwnerId != ownerId)
        {
            error = "You do not have permission to manage meals for this restaurant.";
            return;
        }

        meals = await Meals.GetByRestaurantAsync(RestaurantId);
    }

    private void RequestRemove(MealDto meal)
    {
        pendingRemoveMealId = meal.Id;
        removeDialogMessage = $"Remove \"{meal.Name}\"? This cannot be undone.";
        showRemoveDialog = true;
    }

    private async Task RemoveConfirmedAsync()
    {
        if (pendingRemoveMealId is null || meals is null)
            return;

        var mealId = pendingRemoveMealId.Value;
        pendingRemoveMealId = null;

        removingId = mealId;
        error = null;
        var result = await Meals.RemoveAsync(RestaurantId, mealId);
        removingId = null;

        if (!result.Success)
        {
            error = result.Error ?? "Failed to remove meal.";
            return;
        }

        var meal = meals.FirstOrDefault(m => m.Id == mealId);
        if (meal is not null)
            meals.Remove(meal);
    }
}
