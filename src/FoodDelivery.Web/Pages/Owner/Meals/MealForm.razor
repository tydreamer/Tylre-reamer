@page "/owner/restaurants/{RestaurantId:int}/meals/new"
@page "/owner/restaurants/{RestaurantId:int}/meals/{MealId:int}/edit"
@attribute [Authorize(Roles = "Owner")]
@inject RestaurantService Restaurants
@inject MealService Meals
@inject ImageUploadService ImageUpload
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<PageTitle>@(IsNew ? "Add Meal" : "Edit Meal")</PageTitle>

<div class="mb-4">
    <a href="owner/restaurants/@RestaurantId/meals" class="btn btn-link ps-0">&larr; Back to meals</a>
    <h1>@(IsNew ? "Add Meal" : "Edit Meal")</h1>
    @if (restaurant is not null)
    {
        <p class="text-muted mb-0">@restaurant.Name</p>
    }
</div>

@if (loadError is not null)
{
    <div class="alert alert-danger">@loadError</div>
}
else if (restaurant is null || mealTypes is null || (!IsNew && meal is null))
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-6">
            <EditForm Model="formModel" OnValidSubmit="HandleSubmit">
                <DataAnnotationsValidator />
                <div class="mb-3">
                    <label class="form-label">Name</label>
                    <InputText class="form-control" @bind-Value="formModel.Name" />
                    <FirstValidationMessage For="() => formModel.Name" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Description</label>
                    <InputTextArea class="form-control" rows="3" @bind-Value="formModel.Description" />
                    <FirstValidationMessage For="() => formModel.Description" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Type</label>
                    <InputSelect class="form-select" @bind-Value="formModel.MealTypeId">
                        <option value="0">Select meal type</option>
                        @foreach (var type in mealTypes)
                        {
                            <option value="@type.Id">@type.Name</option>
                        }
                    </InputSelect>
                    <FirstValidationMessage For="() => formModel.MealTypeId" />
                </div>
                <div class="mb-3">
                    <OwnerImageUpload Label="Image"
                                      ExistingImageUrl="@formModel.ImageUrl"
                                      Selection="imageSelection"
                                      SelectionChanged="OnImageSelectionChanged"
                                      PreviewAlt="@(string.IsNullOrWhiteSpace(formModel.Name) ? "Meal image" : formModel.Name)"
                                      Disabled="@saving" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Price</label>
                    <InputNumber class="form-control" @bind-Value="formModel.Price" />
                    <FirstValidationMessage For="() => formModel.Price" />
                </div>
                @if (submitError is not null)
                {
                    <div class="alert alert-danger">@submitError</div>
                }
                <button class="btn btn-primary" type="submit" disabled="@saving">
                    @(saving ? "Saving..." : IsNew ? "Create" : "Save")
                </button>
                <a href="owner/restaurants/@RestaurantId/meals" class="btn btn-outline-secondary ms-2">Cancel</a>
            </EditForm>
        </div>
    </div>
}

@code {
    [Parameter] public int RestaurantId { get; set; }
    [Parameter] public int? MealId { get; set; }

    private bool IsNew => MealId is null;
    private RestaurantDto? restaurant;
    private MealDto? meal;
    private List<MealTypeDto>? mealTypes;
    private MealFormModel formModel = new();
    private string? loadError;
    private string? submitError;
    private bool saving;
    private ImageUploadSelection imageSelection = new();

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthStateProvider.GetAuthenticationStateAsync()).User;
        var ownerId = user.GetUserId();
        if (ownerId is null)
        {
            loadError = "Unable to determine your account. Please sign in again.";
            return;
        }

        mealTypes = await Meals.GetMealTypesAsync();
        if (mealTypes.Count == 0)
        {
            loadError = "Meal types are not available. Please contact support.";
            return;
        }

        restaurant = await Restaurants.GetByIdAsync(RestaurantId);
        if (restaurant is null)
        {
            loadError = "Restaurant not found.";
            return;
        }

        if (restaurant.OwnerId != ownerId)
        {
            loadError = "You do not have permission to manage meals for this restaurant.";
            return;
        }

        if (IsNew)
            return;

        meal = await Meals.GetByIdAsync(RestaurantId, MealId!.Value);
        if (meal is null)
        {
            loadError = "Meal not found.";
            return;
        }

        formModel = new MealFormModel
        {
            Name = meal.Name,
            Description = meal.Description,
            ImageUrl = meal.ImageUrl,
            Price = meal.Price,
            MealTypeId = meal.MealTypeId
        };
    }

    private Task OnImageSelectionChanged(ImageUploadSelection selection)
    {
        imageSelection = selection;
        return Task.CompletedTask;
    }

    private async Task HandleSubmit()
    {
        saving = true;
        submitError = null;

        if (IsNew)
        {
            var request = new MealCreateRequest(
                formModel.Name,
                formModel.Description,
                "",
                formModel.Price,
                formModel.MealTypeId);
            var (success, created, error) = await Meals.CreateAsync(RestaurantId, request);
            if (!success)
            {
                saving = false;
                submitError = error ?? "Failed to create meal.";
                return;
            }

            if (created is not null && imageSelection.HasPendingUpload && imageSelection.PendingFile is not null)
            {
                var (uploaded, _, uploadError) = await ImageUpload.UploadMealImageAsync(
                    RestaurantId, created.Id, imageSelection.PendingFile);
                if (!uploaded)
                {
                    saving = false;
                    submitError = uploadError ?? "Meal was created but the image could not be uploaded.";
                    return;
                }
            }

            saving = false;
            Navigation.NavigateTo($"owner/restaurants/{RestaurantId}/meals");
            return;
        }

        var (imageUrl, imageError) = await ResolveMealImageUrlAsync(MealId!.Value);
        if (imageError is not null)
        {
            saving = false;
            submitError = imageError;
            return;
        }

        var updateRequest = new MealUpdateRequest(
            formModel.Name,
            formModel.Description,
            imageUrl,
            formModel.Price,
            formModel.MealTypeId);
        var (updated, updateError) = await Meals.UpdateAsync(RestaurantId, MealId!.Value, updateRequest);
        saving = false;
        if (!updated)
        {
            submitError = updateError ?? "Failed to update meal.";
            return;
        }

        Navigation.NavigateTo($"owner/restaurants/{RestaurantId}/meals");
    }

    private async Task<(string ImageUrl, string? Error)> ResolveMealImageUrlAsync(int mealId)
    {
        if (imageSelection.ShouldClear)
            return ("", null);

        if (imageSelection.PendingFile is { } file)
        {
            var (uploaded, url, error) = await ImageUpload.UploadMealImageAsync(RestaurantId, mealId, file);
            return uploaded
                ? (url ?? "", null)
                : ("", error ?? "Failed to upload image.");
        }

        return (formModel.ImageUrl, null);
    }

    private class MealFormModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = ValidationMessages.NameRequired)]
        [System.ComponentModel.DataAnnotations.MaxLength(100, ErrorMessage = ValidationMessages.NameTooLong)]
        public string Name { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = ValidationMessages.DescriptionRequired)]
        [System.ComponentModel.DataAnnotations.MaxLength(500, ErrorMessage = ValidationMessages.DescriptionTooLong)]
        public string Description { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Range(1, int.MaxValue, ErrorMessage = ValidationMessages.MealTypeRequired)]
        public int MealTypeId { get; set; }

        public string ImageUrl { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Range(0.01, 100_000, ErrorMessage = ValidationMessages.PriceInvalid)]
        public decimal Price { get; set; }
    }
}
