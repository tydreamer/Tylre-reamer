@page "/owner/orders/{Id:int}"
@attribute [Authorize(Roles = "Owner")]
@inject OrderService Orders
@inject UserService Users

@if (order is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <PageTitle>Order #@order.Id</PageTitle>

    <div class="mb-4">
        <a href="owner/orders" class="btn btn-link ps-0">&larr; Back to incoming orders</a>
        <div class="page-header mb-2">
            <h1 class="mb-0">Order #@order.Id</h1>
            <span class="badge fs-6 @StatusClass(order.Status) align-self-start">@order.Status</span>
        </div>
        <p class="text-muted mb-0">
            @order.RestaurantName · @order.CustomerName · Ordered at @order.CreatedAt.ToLocalTime().ToString("f")
        </p>
    </div>

    <div class="row">
        <div class="col-md-7">
            <h5>Meals</h5>
            <div class="table-responsive">
                <table class="table mb-0">
                    <thead>
                        <tr>
                            <th>Meal</th>
                            <th class="text-center">Qty</th>
                            <th class="text-end">Unit</th>
                            <th class="text-end">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in order.Items)
                        {
                            <tr>
                                <td>@item.MealName</td>
                                <td class="text-center">@item.Quantity</td>
                                <td class="text-end text-nowrap">@item.UnitPrice.ToString("C")</td>
                                <td class="text-end text-nowrap">@((item.UnitPrice * item.Quantity).ToString("C"))</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="3" class="text-end">Tip</td>
                            <td class="text-end text-nowrap">@order.Tip.ToString("C")</td>
                        </tr>
                        <tr class="fw-bold">
                            <td colspan="3" class="text-end">Total</td>
                            <td class="text-end text-nowrap">@order.TotalPrice.ToString("C")</td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            @if (error is not null)
            {
                <div class="alert alert-danger">@error</div>
            }
            @if (blockSuccess is not null)
            {
                <div class="alert alert-success">@blockSuccess</div>
            }

            <div class="d-flex flex-wrap gap-2">
                @foreach (var action in GetActions(order.Status))
                {
                    <button class="btn @action.ButtonClass"
                            disabled="@busy"
                            @onclick="() => OnStatusActionAsync(action.Status)">
                        @action.Label
                    </button>
                }
                @if (order.CustomerBlockedFromOwner)
                {
                    <button class="btn btn-outline-success"
                            disabled="@busy"
                            @onclick="UnblockCustomerAsync">
                        Unblock customer
                    </button>
                }
                else
                {
                    <button class="btn btn-outline-danger"
                            disabled="@busy"
                            @onclick="() => showBlockDialog = true">
                        Block customer
                    </button>
                }
            </div>
        </div>

        <div class="col-md-5">
            <h5>Status history</h5>
            <div class="table-responsive">
                <table class="table mb-0">
                    <thead>
                        <tr>
                            <th>Status</th>
                            <th class="text-end">Time</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in order.StatusHistory)
                        {
                            <tr>
                                <td><span class="badge @StatusClass(entry.Status)">@entry.Status</span></td>
                                <td class="text-end text-muted text-nowrap">@entry.ChangedAt.ToLocalTime().ToString("g")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <ConfirmDialog @bind-IsVisible="showCancelDialog"
                   Title="Cancel order"
                   Message="Are you sure you want to cancel this order? This cannot be undone."
                   ConfirmText="Cancel order"
                   CancelText="Keep order"
                   ConfirmButtonClass="btn-danger"
                   OnConfirmed="CancelOrderConfirmedAsync" />

    <ConfirmDialog @bind-IsVisible="showBlockDialog"
                   Title="Block customer"
                   Message="@($"Block {order.CustomerName} from ordering at your restaurants? They can still sign in and order elsewhere.")"
                   ConfirmText="Block customer"
                   CancelText="Cancel"
                   ConfirmButtonClass="btn-danger"
                   OnConfirmed="BlockCustomerConfirmedAsync" />

}

@code {
    [Parameter] public int Id { get; set; }

    private OrderResponse? order;
    private string? error;
    private string? blockSuccess;
    private bool busy;
    private bool showCancelDialog;
    private bool showBlockDialog;

    protected override async Task OnInitializedAsync()
    {
        order = await Orders.GetByIdAsync(Id);
    }

    private Task OnStatusActionAsync(string status)
    {
        if (status == "Cancelled")
        {
            showCancelDialog = true;
            return Task.CompletedTask;
        }

        return UpdateStatusAsync(status);
    }

    private Task CancelOrderConfirmedAsync() => UpdateStatusAsync("Cancelled");

    private async Task UpdateStatusAsync(string status)
    {
        busy = true;
        error = null;
        var (success, err) = await Orders.UpdateStatusAsync(Id, status);
        if (success)
            order = await Orders.GetByIdAsync(Id);
        else
            error = err;
        busy = false;
    }

    private async Task BlockCustomerConfirmedAsync()
    {
        if (order is null) return;

        busy = true;
        error = null;
        blockSuccess = null;
        var (success, err) = await Users.BlockAsync(order.CustomerId);
        busy = false;

        if (!success)
        {
            error = err ?? "Failed to block customer.";
            return;
        }

        order = order with { CustomerBlockedFromOwner = true };
        blockSuccess = $"{order.CustomerName} can no longer order from your restaurants.";
    }

    private async Task UnblockCustomerAsync()
    {
        if (order is null) return;

        busy = true;
        error = null;
        blockSuccess = null;
        var (success, err) = await Users.UnblockAsync(order.CustomerId);
        busy = false;

        if (!success)
        {
            error = err ?? "Failed to unblock customer.";
            return;
        }

        order = order with { CustomerBlockedFromOwner = false };
        blockSuccess = $"{order.CustomerName} can order from your restaurants again.";
    }

    private static IEnumerable<(string Status, string Label, string ButtonClass)> GetActions(string status) =>
        status switch
        {
            "Placed" =>
            [
                ("Processing", "Start processing", "btn-primary"),
                ("Cancelled", "Cancel order", "btn-outline-danger")
            ],
            "Processing" => [("InRoute", "Mark in route", "btn-primary")],
            "InRoute" => [("Delivered", "Mark delivered", "btn-primary")],
            _ => []
        };

    private static string StatusClass(string status) => status switch
    {
        "Placed" => "bg-secondary",
        "Processing" => "bg-info",
        "InRoute" => "bg-warning text-dark",
        "Delivered" => "bg-primary",
        "Received" => "bg-success",
        "Cancelled" => "bg-danger",
        _ => "bg-secondary"
    };
}
