@page "/owner/restaurants/new"
@page "/owner/restaurants/{Id:int}/edit"
@attribute [Authorize(Roles = "Owner")]
@inject RestaurantService Restaurants
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<PageTitle>@(IsNew ? "Add Restaurant" : "Edit Restaurant")</PageTitle>

<div class="mb-4">
    <a href="owner/restaurants" class="btn btn-link ps-0">&larr; Back to my restaurants</a>
    <h1>@(IsNew ? "Add Restaurant" : "Edit Restaurant")</h1>
</div>

@if (loadError is not null)
{
    <div class="alert alert-danger">@loadError</div>
}
else if (!IsNew && (model is null || cuisines is null))
{
    <p><em>Loading...</em></p>
}
else if (IsNew && cuisines is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-6">
            <EditForm Model="formModel" OnValidSubmit="HandleSubmit">
                <DataAnnotationsValidator />
                <div class="mb-3">
                    <label class="form-label">Name</label>
                    <InputText class="form-control" @bind-Value="formModel.Name" />
                    <FirstValidationMessage For="() => formModel.Name" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Description</label>
                    <InputTextArea class="form-control" rows="3" @bind-Value="formModel.Description" />
                    <FirstValidationMessage For="() => formModel.Description" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Image URL</label>
                    <InputText class="form-control" @bind-Value="formModel.ImageUrl" />
                    <FirstValidationMessage For="() => formModel.ImageUrl" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Cuisine</label>
                    <InputSelect class="form-select" @bind-Value="formModel.CuisineId">
                        <option value="0">Select cuisine</option>
                        @foreach (var cuisine in cuisines!)
                        {
                            <option value="@cuisine.Id">@cuisine.Name</option>
                        }
                    </InputSelect>
                    <FirstValidationMessage For="() => formModel.CuisineId" />
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-sm-6">
                        <label class="form-label">Latitude</label>
                        <InputNumber class="form-control" @bind-Value="formModel.Latitude" />
                        <FirstValidationMessage For="() => formModel.Latitude" />
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label">Longitude</label>
                        <InputNumber class="form-control" @bind-Value="formModel.Longitude" />
                        <FirstValidationMessage For="() => formModel.Longitude" />
                    </div>
                </div>
                @if (submitError is not null)
                {
                    <div class="alert alert-danger">@submitError</div>
                }
                <button class="btn btn-primary" type="submit" disabled="@saving">
                    @(saving ? "Saving..." : IsNew ? "Create" : "Save")
                </button>
                <a href="owner/restaurants" class="btn btn-outline-secondary ms-2">Cancel</a>
            </EditForm>
        </div>
    </div>
}

@code {
    [Parameter] public int? Id { get; set; }

    private bool IsNew => Id is null;
    private RestaurantFormModel formModel = new();
    private RestaurantDto? model;
    private List<CuisineDto>? cuisines;
    private string? loadError;
    private string? submitError;
    private bool saving;
    private int? ownerId;

    protected override async Task OnInitializedAsync()
    {
        cuisines = await Restaurants.GetCuisinesAsync();
        if (cuisines.Count == 0)
        {
            loadError = "No cuisines are configured.";
            return;
        }

        var user = (await AuthStateProvider.GetAuthenticationStateAsync()).User;
        ownerId = user.GetUserId();
        if (ownerId is null)
        {
            loadError = "Unable to determine your account. Please sign in again.";
            return;
        }

        if (IsNew)
            return;

        model = await Restaurants.GetByIdAsync(Id!.Value);
        if (model is null)
        {
            loadError = "Restaurant not found.";
            return;
        }

        if (model.OwnerId != ownerId)
        {
            loadError = "You do not have permission to edit this restaurant.";
            return;
        }

        formModel = new RestaurantFormModel
        {
            Name = model.Name,
            Description = model.Description,
            ImageUrl = model.ImageUrl,
            CuisineId = model.CuisineId,
            Latitude = model.Latitude,
            Longitude = model.Longitude
        };
    }

    private async Task HandleSubmit()
    {
        saving = true;
        submitError = null;
        var request = new RestaurantUpsertRequest(
            formModel.Name,
            formModel.Description,
            formModel.ImageUrl,
            formModel.CuisineId,
            formModel.Latitude,
            formModel.Longitude);

        if (IsNew)
        {
            var (success, _, error) = await Restaurants.CreateAsync(request);
            saving = false;
            if (!success)
            {
                submitError = error ?? "Failed to create restaurant.";
                return;
            }

            Navigation.NavigateTo("owner/restaurants");
            return;
        }

        var (updated, updateError) = await Restaurants.UpdateAsync(Id!.Value, request);
        saving = false;
        if (!updated)
        {
            submitError = updateError ?? "Failed to update restaurant.";
            return;
        }

        Navigation.NavigateTo("owner/restaurants");
    }

    private class RestaurantFormModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = ValidationMessages.NameRequired)]
        [System.ComponentModel.DataAnnotations.MaxLength(100, ErrorMessage = ValidationMessages.NameTooLong)]
        public string Name { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = ValidationMessages.DescriptionRequired)]
        [System.ComponentModel.DataAnnotations.MaxLength(500, ErrorMessage = ValidationMessages.DescriptionTooLong)]
        public string Description { get; set; } = "";

        [System.ComponentModel.DataAnnotations.MaxLength(500, ErrorMessage = ValidationMessages.ImageUrlTooLong)]
        public string ImageUrl { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Range(1, int.MaxValue, ErrorMessage = ValidationMessages.CuisineRequired)]
        public int CuisineId { get; set; }

        [System.ComponentModel.DataAnnotations.Range(-90, 90, ErrorMessage = ValidationMessages.LatitudeInvalid)]
        public double Latitude { get; set; }

        [System.ComponentModel.DataAnnotations.Range(-180, 180, ErrorMessage = ValidationMessages.LongitudeInvalid)]
        public double Longitude { get; set; }
    }
}
