@page "/owner/restaurants/{RestaurantId:int}/coupons"
@attribute [Authorize(Roles = "Owner")]
@inject RestaurantService Restaurants
@inject CouponService Coupons
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>@(restaurant?.Name ?? "Coupons")</PageTitle>

<div class="mb-4">
    <a href="owner/restaurants" class="btn btn-link ps-0">&larr; Back to my restaurants</a>
    @if (restaurant is not null)
    {
        <h1 class="mb-0">@restaurant.Name — Coupons</h1>
    }
</div>

@if (error is not null)
{
    <div class="alert alert-danger">@error</div>
}

@if (restaurant is null || coupons is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-5 mb-4">
            <h5 class="mb-3">Add Coupon</h5>
            <EditForm Model="formModel" OnValidSubmit="CreateAsync">
                <DataAnnotationsValidator />
                <div class="mb-3">
                    <label class="form-label">Code</label>
                    <InputText class="form-control" @bind-Value="formModel.Code" />
                    <FirstValidationMessage For="() => formModel.Code" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Discount (%)</label>
                    <InputNumber class="form-control" @bind-Value="formModel.DiscountValue" min="1" max="100" />
                    <FirstValidationMessage For="() => formModel.DiscountValue" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Expires</label>
                    <InputDate class="form-control" @bind-Value="formModel.ExpiresAt" />
                    <FirstValidationMessage For="() => formModel.ExpiresAt" />
                </div>
                @if (createError is not null)
                {
                    <div class="alert alert-danger">@createError</div>
                }
                <button class="btn btn-primary" type="submit" disabled="@creating">
                    @(creating ? "Creating..." : "Add Coupon")
                </button>
            </EditForm>
        </div>
        <div class="col-md-7">
            <h5 class="mb-3">Coupons</h5>
            @if (coupons.Count == 0)
            {
                <div class="alert alert-info">No coupons yet.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Code</th>
                                <th>Discount</th>
                                <th>Expires</th>
                                <th>Active</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var coupon in coupons)
                            {
                                <tr>
                                    <td class="coupon-code-cell" title="@coupon.Code">
                                        @DisplayTextHelper.TruncateWithEllipsis(coupon.Code)
                                    </td>
                                    <td>@coupon.DiscountValue.ToString("0.##")%</td>
                                    <td class="text-nowrap">@coupon.ExpiresAt.ToLocalTime().ToString("d")</td>
                                    <td>@(coupon.IsActive ? "Yes" : "No")</td>
                                    <td class="text-end text-nowrap">
                                        <button type="button" class="btn btn-sm btn-outline-danger"
                                                disabled="@(removingId == coupon.Id)"
                                                @onclick="() => RequestRemove(coupon)">
                                            @(removingId == coupon.Id ? "Removing..." : "Remove")
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}

<ConfirmDialog @bind-IsVisible="showRemoveDialog"
               Title="Remove coupon"
               Message="@removeDialogMessage"
               ConfirmText="Remove"
               CancelText="Cancel"
               ConfirmButtonClass="btn-danger"
               OnConfirmed="RemoveConfirmedAsync" />

@code {
    [Parameter] public int RestaurantId { get; set; }

    private RestaurantDto? restaurant;
    private List<CouponDto>? coupons;
    private readonly CouponFormModel formModel = new() { ExpiresAt = DateTime.Today.AddDays(30) };
    private string? error;
    private string? createError;
    private bool creating;
    private int? removingId;
    private bool showRemoveDialog;
    private int? pendingRemoveCouponId;
    private string removeDialogMessage = "";

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthStateProvider.GetAuthenticationStateAsync()).User;
        var ownerId = user.GetUserId();
        if (ownerId is null)
        {
            error = "Unable to determine your account. Please sign in again.";
            return;
        }

        restaurant = await Restaurants.GetByIdAsync(RestaurantId);
        if (restaurant is null)
        {
            error = "Restaurant not found.";
            return;
        }

        if (restaurant.OwnerId != ownerId)
        {
            error = "You do not have permission to manage coupons for this restaurant.";
            return;
        }

        coupons = await Coupons.GetByRestaurantAsync(RestaurantId);
    }

    private async Task CreateAsync()
    {
        creating = true;
        createError = null;
        var expiresAt = DateTime.SpecifyKind(formModel.ExpiresAt.Date, DateTimeKind.Utc).AddDays(1).AddTicks(-1);
        var request = new CouponCreateRequest(formModel.Code, formModel.DiscountValue, expiresAt);
        var (success, coupon, createErr) = await Coupons.CreateAsync(RestaurantId, request);
        creating = false;

        if (!success)
        {
            createError = createErr ?? "Failed to create coupon.";
            return;
        }

        coupons!.Add(coupon!);
        coupons = coupons.OrderByDescending(c => c.ExpiresAt).ToList();
        formModel.Code = "";
        formModel.DiscountValue = 0;
    }

    private void RequestRemove(CouponDto coupon)
    {
        pendingRemoveCouponId = coupon.Id;
        removeDialogMessage = $"Remove coupon \"{coupon.Code}\"? This cannot be undone.";
        showRemoveDialog = true;
    }

    private async Task RemoveConfirmedAsync()
    {
        if (pendingRemoveCouponId is null || coupons is null)
            return;

        var couponId = pendingRemoveCouponId.Value;
        pendingRemoveCouponId = null;

        removingId = couponId;
        error = null;
        var (success, removeError) = await Coupons.RemoveAsync(RestaurantId, couponId);
        removingId = null;

        if (!success)
        {
            error = removeError ?? "Failed to remove coupon.";
            return;
        }

        var coupon = coupons.FirstOrDefault(c => c.Id == couponId);
        if (coupon is not null)
            coupons.Remove(coupon);
    }

    private class CouponFormModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = ValidationMessages.CodeRequired)]
        public string Code { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = ValidationMessages.DiscountRequired)]
        [System.ComponentModel.DataAnnotations.Range(1, 100, ErrorMessage = ValidationMessages.DiscountInvalid)]
        public decimal DiscountValue { get; set; }

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = ValidationMessages.ExpiresAtRequired)]
        public DateTime ExpiresAt { get; set; }
    }
}
