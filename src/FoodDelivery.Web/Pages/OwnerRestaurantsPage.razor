@page "/owner/restaurants"
@attribute [Authorize(Roles = "Owner")]
@inject RestaurantService Restaurants
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>My Restaurants</PageTitle>

<div class="page-header mb-4">
    <h1 class="mb-0">My Restaurants</h1>
    <a href="owner/restaurants/new" class="btn btn-primary">Add Restaurant</a>
</div>

@if (error is not null)
{
    <div class="alert alert-danger">@error</div>
}

@if (restaurants is null)
{
    <p><em>Loading...</em></p>
}
else if (restaurants.Count == 0)
{
    <div class="alert alert-info">You don't have any restaurants yet.</div>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Cuisine</th>
                    <th>Description</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var restaurant in restaurants)
                {
                    <tr>
                        <td>@restaurant.Name</td>
                        <td><span class="badge meal-type-badge">@restaurant.CuisineName</span></td>
                        <td class="meal-card-line" style="max-width: 16rem;" title="@restaurant.Description">@restaurant.Description</td>
                        <td class="text-end text-nowrap">
                            <a href="owner/restaurants/@restaurant.Id/meals" class="btn btn-sm btn-outline-secondary">Meals</a>
                            <a href="owner/restaurants/@restaurant.Id/coupons" class="btn btn-sm btn-outline-secondary">Coupons</a>
                            <a href="owner/restaurants/@restaurant.Id/edit" class="btn btn-sm btn-outline-primary">Edit</a>
                            <button type="button" class="btn btn-sm btn-outline-danger"
                                    disabled="@(removingId == restaurant.Id)"
                                    @onclick="() => RequestRemove(restaurant)">
                                @(removingId == restaurant.Id ? "Removing..." : "Remove")
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<ConfirmDialog @bind-IsVisible="showRemoveDialog"
               Title="Remove restaurant"
               Message="@removeDialogMessage"
               ConfirmText="Remove"
               CancelText="Cancel"
               ConfirmButtonClass="btn-danger"
               OnConfirmed="RemoveConfirmedAsync" />

@code {
    private List<RestaurantDto>? restaurants;
    private string? error;
    private int? removingId;
    private bool showRemoveDialog;
    private int? pendingRemoveRestaurantId;
    private string removeDialogMessage = "";

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthStateProvider.GetAuthenticationStateAsync()).User;
        var ownerId = user.GetUserId();
        if (ownerId is null)
        {
            error = "Unable to determine your account. Please sign in again.";
            restaurants = [];
            return;
        }

        restaurants = await Restaurants.GetByOwnerAsync(ownerId.Value);
    }

    private void RequestRemove(RestaurantDto restaurant)
    {
        pendingRemoveRestaurantId = restaurant.Id;
        removeDialogMessage = $"Remove \"{restaurant.Name}\"? This cannot be undone.";
        showRemoveDialog = true;
    }

    private async Task RemoveConfirmedAsync()
    {
        if (pendingRemoveRestaurantId is null || restaurants is null)
            return;

        var restaurantId = pendingRemoveRestaurantId.Value;
        pendingRemoveRestaurantId = null;

        removingId = restaurantId;
        error = null;
        var (success, removeError) = await Restaurants.RemoveAsync(restaurantId);
        removingId = null;

        if (!success)
        {
            error = removeError ?? "Failed to remove restaurant.";
            return;
        }

        var restaurant = restaurants.FirstOrDefault(r => r.Id == restaurantId);
        if (restaurant is not null)
            restaurants.Remove(restaurant);
    }
}
