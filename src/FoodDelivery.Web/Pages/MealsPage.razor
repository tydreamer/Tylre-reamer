@page "/meals"
@inject MealService Meals

<PageTitle>Meals</PageTitle>

<h1 class="mb-4">Meals</h1>

@if (meals is null)
{
    <p><em>Loading...</em></p>
}
else if (meals.Count == 0)
{
    <div class="alert alert-info">No meals available yet.</div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
        @foreach (var meal in meals)
        {
            <div class="col">
                <a href="meals/@meal.Id" class="text-decoration-none text-dark">
                    <div class="card h-100 shadow-sm">
                        @if (!string.IsNullOrWhiteSpace(meal.ImageUrl))
                        {
                            <img src="@meal.ImageUrl" class="card-img-top" alt="@meal.Name"
                                 style="height: 180px; object-fit: cover;" />
                        }
                        <div class="card-body">
                            <h5 class="card-title mb-1">@meal.Name</h5>
                            <p class="text-muted small mb-2">@meal.RestaurantName</p>
                            <p class="card-text">@meal.Description</p>
                            <div class="d-flex justify-content-between align-items-center mt-2">
                                <span class="badge bg-success fs-6">@meal.Price.ToString("C")</span>
                                @if (!meal.IsAvailable)
                                {
                                    <span class="badge bg-secondary">Unavailable</span>
                                }
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
}

@code {
    private List<MealBrowseDto>? meals;

    protected override async Task OnInitializedAsync()
    {
        meals = await Meals.GetAllAsync();
    }
}
