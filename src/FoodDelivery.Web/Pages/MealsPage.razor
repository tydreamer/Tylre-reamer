@page "/meals"
@attribute [Authorize(Roles = "Customer")]
@inject MealService Meals

<PageTitle>Meals</PageTitle>

<h1 class="mb-4">Meals</h1>

<BrowseSearchBar @bind-SearchTerm="searchTerm" OnSearch="ApplySearchAsync" />

@if (paged is null)
{
    <p><em>Loading...</em></p>
}
else if (paged.TotalCount == 0)
{
    <div class="alert alert-info">
        @(HasActiveSearch ? "No meals match your search." : "No meals available yet.")
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
        @foreach (var meal in paged.Items)
        {
            <div class="col">
                <a href="meals/@meal.Id" class="text-decoration-none text-dark">
                    <div class="card h-100 shadow-sm">
                        @if (!string.IsNullOrWhiteSpace(meal.ImageUrl))
                        {
                            <img src="@meal.ImageUrl" class="card-img-top" alt="@meal.Name"
                                 style="height: 180px; object-fit: cover;" />
                        }
                        <div class="card-body">
                            <h5 class="card-title mb-1">@meal.Name</h5>
                            <p class="text-muted small mb-2">@meal.RestaurantName</p>
                            <p class="card-text">@meal.Description</p>
                            <div class="d-flex justify-content-between align-items-center mt-2">
                                <span class="badge bg-success fs-6">@meal.Price.ToString("C")</span>
                                @if (!meal.IsAvailable)
                                {
                                    <span class="badge bg-secondary">Unavailable</span>
                                }
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>

    <PaginationBar CurrentPage="currentPage" TotalPages="paged.TotalPages"
                   TotalCount="paged.TotalCount" PageSize="pageSize"
                   PageSizeOptions="BrowsePageSizeOptions"
                   OnPageChanged="GoToPage" OnPageSizeChanged="ChangePageSize" />
}

@code {
    private PagedResult<MealBrowseDto>? paged;
    private int currentPage = 1;
    private int pageSize = 12;
    private string searchTerm = "";
    private static readonly int[] BrowsePageSizeOptions = [12, 24, 48];

    private bool HasActiveSearch => !string.IsNullOrWhiteSpace(searchTerm);

    protected override async Task OnInitializedAsync()
    {
        await LoadPageAsync();
    }

    private async Task ApplySearchAsync()
    {
        currentPage = 1;
        await LoadPageAsync();
    }

    private async Task LoadPageAsync()
    {
        paged = await Meals.GetPageAsync(currentPage, pageSize, searchTerm);
    }

    private async Task GoToPage(int page)
    {
        if (paged is null || page < 1 || page > paged.TotalPages) return;
        currentPage = page;
        await LoadPageAsync();
    }

    private async Task ChangePageSize(int size)
    {
        pageSize = size;
        currentPage = 1;
        await LoadPageAsync();
    }
}
