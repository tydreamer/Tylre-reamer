@page "/"
@layout AuthLayout
@attribute [AllowAnonymous]
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<PageTitle>Food Delivery</PageTitle>

@code {
    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthStateProvider.GetAuthenticationStateAsync()).User;
        if (user.Identity?.IsAuthenticated != true)
        {
            Navigation.NavigateTo("/sign-in", replace: true);
            return;
        }

        if (user.IsInRole("Admin"))
            Navigation.NavigateTo("/admin/users", replace: true);
        else if (user.IsInRole("Owner"))
            Navigation.NavigateTo("/owner/restaurants", replace: true);
        else
            Navigation.NavigateTo("/restaurants", replace: true);
    }
}
