@page "/forgot-password"
@layout AuthLayout
@attribute [AllowAnonymous]
@inject AuthService Auth
@inject NavigationManager Navigation

<PageTitle>Forgot Password</PageTitle>

<div class="card auth-card shadow border-0">
    <div class="card-body p-4">
        <h3 class="text-center mb-4">Forgot Password</h3>

        @if (submitted)
        {
            <div class="alert alert-success mb-3">@successMessage</div>
            @if (deliveryNote is not null)
            {
                <div class="alert alert-info small mb-3">@deliveryNote</div>
            }
            <a href="/sign-in" class="btn btn-primary w-100">Back to Sign In</a>
        }
        else
        {
            <p class="text-muted text-center mb-4">
                Enter your email and we'll send you a link to reset your password. Google sign-in accounts cannot use this form.
            </p>
            <EditForm Model="model" OnValidSubmit="HandleSubmit">
                <DataAnnotationsValidator />
                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <InputText class="form-control" @bind-Value="model.Email" type="email" />
                    <FirstValidationMessage For="() => model.Email" />
                </div>
                @if (error is not null)
                {
                    <div class="alert alert-danger mb-3">@error</div>
                }
                <button class="btn btn-primary w-100" type="submit" disabled="@loading">
                    @(loading ? "Sending..." : "Send reset link")
                </button>
            </EditForm>
            <p class="mt-3 mb-0 text-center text-muted">
                <a href="/sign-in">Back to Sign In</a>
            </p>
        }
    </div>
</div>

@code {
    private readonly ForgotPasswordModel model = new();
    private string? error;
    private string? successMessage;
    private string? deliveryNote;
    private bool loading;
    private bool submitted;

    private async Task HandleSubmit()
    {
        loading = true;
        error = null;
        var (success, message, note) = await Auth.ForgotPasswordAsync(model.Email);
        loading = false;

        if (!success)
        {
            error = message;
            return;
        }

        successMessage = message;
        deliveryNote = note;
        submitted = true;
    }

    private class ForgotPasswordModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = ValidationMessages.EmailRequired)]
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = ValidationMessages.EmailInvalid)]
        [System.ComponentModel.DataAnnotations.MaxLength(255, ErrorMessage = ValidationMessages.EmailTooLong)]
        public string Email { get; set; } = "";
    }
}
