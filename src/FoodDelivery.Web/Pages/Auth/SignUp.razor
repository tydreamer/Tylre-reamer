@page "/sign-up"
@layout AuthLayout
@attribute [AllowAnonymous]
@using System.ComponentModel.DataAnnotations
@inject AuthService Auth
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Sign Up</PageTitle>

<div class="card auth-card shadow border-0">
    <div class="card-body p-4">
        <h3 class="text-center mb-4">Sign Up</h3>

        <EditForm EditContext="editContext" OnValidSubmit="HandleSignUp">
            <div class="mb-3">
                <label class="form-label">Name</label>
                <InputText class="form-control" @bind-Value="model.Name" />
                <FirstValidationMessage For="() => model.Name" />
            </div>
            <div class="mb-3">
                <label class="form-label">Email</label>
                <InputText class="form-control" @bind-Value="model.Email" type="email" />
                <FirstValidationMessage For="() => model.Email" />
            </div>
            <div class="mb-3">
                <label class="form-label">Password</label>
                <InputText class="form-control" @bind-Value="model.Password" @bind-Value:after="OnPasswordChanged" type="password" autocomplete="new-password" />
                @if (!string.IsNullOrEmpty(model.Password))
                {
                    <div class="password-strength mt-2" aria-live="polite">
                        <div class="d-flex justify-content-between small mb-1">
                            <span class="text-muted">Password strength</span>
                            <span class="@StrengthLabelClass">@StrengthLabel</span>
                        </div>
                        <div class="progress" style="height: 4px;">
                            <div class="progress-bar @StrengthBarClass" role="progressbar"
                                 style="width: @(passwordStrength.Score * 100 / passwordStrength.MaxScore)%"
                                 aria-valuenow="@passwordStrength.Score"
                                 aria-valuemin="0"
                                 aria-valuemax="@passwordStrength.MaxScore"></div>
                        </div>
                        <ul class="list-unstyled small text-muted mt-2 mb-0 password-requirements">
                            @foreach (var req in PasswordRequirements)
                            {
                                <li class="@(req.Met ? "text-success" : "")">
                                    @(req.Met ? "✓" : "○") @req.Label
                                </li>
                            }
                        </ul>
                    </div>
                }
            </div>
            <div class="mb-3">
                <label class="form-label">Confirm password</label>
                <InputText class="form-control" @bind-Value="model.ConfirmPassword" type="password" autocomplete="new-password" />
                <FirstValidationMessage For="() => model.ConfirmPassword" />
            </div>
            <div class="mb-3">
                <label class="form-label d-block mb-2">Account type</label>
                <RoleSegmentedSwitch @bind-Value="model.Role" />
                <div class="form-text mt-2">@(model.Role == "Owner" ? "Manage restaurants, meals, and orders." : "Browse restaurants and place orders.")</div>
            </div>
            @if (error is not null)
            {
                <div class="alert alert-danger mb-3">@error</div>
            }
            <button class="btn btn-primary w-100" type="submit" disabled="@(loading || !CanSubmit)">
                @(loading ? "Signing up..." : "Sign Up")
            </button>
        </EditForm>

        <div class="auth-divider my-3">
            <span>or</span>
        </div>

        <GoogleAuthButton Flow="signup" Role="@model.Role" />

        <p class="mt-3 mb-0 text-center text-muted">
            Already have an account? <a href="/sign-in">Sign In</a>
        </p>
    </div>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private readonly SignUpModel model = new();
    private EditContext editContext = null!;
    private ValidationMessageStore validationMessages = null!;
    private PasswordStrengthResult passwordStrength = PasswordStrengthResult.Evaluate("");
    private string? error;
    private bool loading;

    private bool CanSubmit => passwordStrength.IsAcceptable
        && !string.IsNullOrWhiteSpace(model.ConfirmPassword)
        && model.Password == model.ConfirmPassword;

    private string StrengthLabel => passwordStrength.Level switch
    {
        PasswordStrengthLevel.Empty => "—",
        PasswordStrengthLevel.Weak => "Weak",
        PasswordStrengthLevel.Fair => "Fair",
        PasswordStrengthLevel.Strong => "Strong",
        _ => "—"
    };

    private string StrengthLabelClass => passwordStrength.Level switch
    {
        PasswordStrengthLevel.Strong => "text-success fw-semibold",
        PasswordStrengthLevel.Fair => "text-warning fw-semibold",
        _ => "text-danger fw-semibold"
    };

    private string StrengthBarClass => passwordStrength.Level switch
    {
        PasswordStrengthLevel.Strong => "bg-success",
        PasswordStrengthLevel.Fair => "bg-warning",
        _ => "bg-danger"
    };

    private IReadOnlyList<(string Label, bool Met)> PasswordRequirements =>
    [
        ("At least 8 characters", model.Password.Length >= 8),
        ("One uppercase letter", model.Password.Any(char.IsUpper)),
        ("One lowercase letter", model.Password.Any(char.IsLower)),
        ("One number", model.Password.Any(char.IsDigit)),
        ("One special character", model.Password.Any(c => !char.IsLetterOrDigit(c)))
    ];

    protected override async Task OnInitializedAsync()
    {
        editContext = new EditContext(model);
        validationMessages = new ValidationMessageStore(editContext);
        editContext.OnValidationRequested += OnValidationRequested;
        editContext.OnFieldChanged += OnFieldChanged;

        if (AuthStateTask is not null)
        {
            var state = await AuthStateTask;
            if (state.User.Identity?.IsAuthenticated == true)
            {
                var role = state.User.IsInRole("Owner") ? "Owner"
                    : state.User.IsInRole("Admin") ? "Admin"
                    : "Customer";
                Navigation.NavigateTo(role switch
                {
                    "Admin" => "/admin/users",
                    "Owner" => "/owner/restaurants",
                    _ => "/restaurants"
                }, replace: true);
            }
        }
    }

    private void OnPasswordChanged()
    {
        passwordStrength = PasswordStrengthResult.Evaluate(model.Password);
        validationMessages.Clear(FieldIdentifier.Create(() => model.Password));
        editContext.NotifyValidationStateChanged();
    }

    private void OnValidationRequested(object? sender, ValidationRequestedEventArgs e) => ValidateForm();

    private void OnFieldChanged(object? sender, FieldChangedEventArgs e)
    {
        if (e.FieldIdentifier.FieldName == nameof(SignUpModel.Password))
            return;

        ValidateForm();
    }

    private void ValidateForm()
    {
        validationMessages.Clear();
        ValidateProperty(nameof(SignUpModel.Name));
        ValidateProperty(nameof(SignUpModel.Email));
        ValidateProperty(nameof(SignUpModel.ConfirmPassword));
        editContext.NotifyValidationStateChanged();
    }

    private void ValidateProperty(string propertyName)
    {
        var property = typeof(SignUpModel).GetProperty(propertyName);
        if (property is null)
            return;

        var field = new FieldIdentifier(model, propertyName);
        var results = new List<ValidationResult>();
        var context = new ValidationContext(model) { MemberName = propertyName };
        Validator.TryValidateProperty(property.GetValue(model), context, results);

        foreach (var result in results)
            validationMessages.Add(field, result.ErrorMessage!);
    }

    public void Dispose()
    {
        if (editContext is null)
            return;

        editContext.OnValidationRequested -= OnValidationRequested;
        editContext.OnFieldChanged -= OnFieldChanged;
    }

    private async Task HandleSignUp()
    {
        if (!passwordStrength.IsAcceptable)
            return;

        loading = true;
        error = null;
        error = await Auth.RegisterAsync(model.Name, model.Email, model.Password, model.Role);
        loading = false;

        if (error is null)
            Navigation.NavigateTo("/sign-in?registered=true");
    }

    private class SignUpModel
    {
        [Required(ErrorMessage = ValidationMessages.NameRequired)]
        [MaxLength(100, ErrorMessage = ValidationMessages.NameTooLong)]
        public string Name { get; set; } = "";

        [Required(ErrorMessage = ValidationMessages.EmailRequired)]
        [EmailAddress(ErrorMessage = ValidationMessages.EmailInvalid)]
        [MaxLength(255, ErrorMessage = ValidationMessages.EmailTooLong)]
        public string Email { get; set; } = "";

        public string Password { get; set; } = "";

        [Required(ErrorMessage = ValidationMessages.PasswordConfirmRequired)]
        [Compare(nameof(Password), ErrorMessage = ValidationMessages.PasswordConfirmMismatch)]
        public string ConfirmPassword { get; set; } = "";

        public string Role { get; set; } = "Customer";
    }
}
