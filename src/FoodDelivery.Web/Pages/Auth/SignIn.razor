@page "/sign-in"
@layout AuthLayout
@attribute [AllowAnonymous]
@inject AuthService Auth
@inject NavigationManager Navigation

<PageTitle>Sign In</PageTitle>

<div class="card auth-card shadow border-0">
    <div class="card-body p-4">
        <h3 class="text-center mb-4">Sign In</h3>

        @if (registered)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                Account created successfully. Sign in to continue.
                <button type="button" class="btn-close" @onclick="() => registered = false"></button>
            </div>
        }

        <EditForm Model="model" OnValidSubmit="HandleSignIn">
            <DataAnnotationsValidator />
            <div class="mb-3">
                <label class="form-label">Email</label>
                <InputText class="form-control" @bind-Value="model.Email" type="email" />
                <FirstValidationMessage For="() => model.Email" />
            </div>
            <div class="mb-3">
                <label class="form-label">Password</label>
                <InputText class="form-control" @bind-Value="model.Password" type="password" />
                <FirstValidationMessage For="() => model.Password" />
                <div class="mt-1 text-end">
                    <a href="/forgot-password" class="small">Forgot password?</a>
                </div>
            </div>
            @if (error is not null)
            {
                <div class="alert alert-danger mb-3">@error</div>
            }
            <button class="btn btn-primary w-100" type="submit" disabled="@loading">
                @(loading ? "Signing in..." : "Sign In")
            </button>
        </EditForm>

        <div class="auth-divider my-3">
            <span>or</span>
        </div>

        <GoogleAuthButton Flow="signin" />

        @if (googleError is not null)
        {
            <div class="alert alert-danger mt-3 mb-0">@googleError</div>
        }

        <p class="mt-3 mb-0 text-center text-muted">
            Don't have an account? <a href="/sign-up">Sign Up</a>
        </p>
    </div>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private readonly SignInModel model = new();
    private string? error;
    private bool loading;
    private bool registered;
    private string? googleError;

    protected override async Task OnInitializedAsync()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        registered = query["registered"] == "true";
        googleError = MapGoogleError(query["error"]);

        if (AuthStateTask is not null)
        {
            var state = await AuthStateTask;
            if (state.User.Identity?.IsAuthenticated == true)
                Navigation.NavigateTo(LandingPath(GetRole(state.User)), replace: true);
        }
    }

    private async Task HandleSignIn()
    {
        loading = true;
        error = null;
        var role = await Auth.LoginAsync(model.Email, model.Password);
        loading = false;

        if (role is null)
            error = "Invalid email or password.";
        else
            Navigation.NavigateTo(LandingPath(role));
    }

    private static string GetRole(System.Security.Claims.ClaimsPrincipal user)
    {
        if (user.IsInRole("Admin")) return "Admin";
        if (user.IsInRole("Owner")) return "Owner";
        return "Customer";
    }

    private static string LandingPath(string role) => role switch
    {
        "Admin" => "/admin/users",
        "Owner" => "/owner/restaurants",
        _ => "/restaurants"
    };

    private static string? MapGoogleError(string? code) => code switch
    {
        "no_account" => "No account found for this Google email. Please sign up first.",
        "email_exists" => "An account with this email already exists. Sign in with your password instead.",
        "blocked" => "This account has been blocked.",
        "google_failed" => "Google sign-in failed. Please try again.",
        _ => null
    };

    private class SignInModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = ValidationMessages.EmailRequired)]
        [ValidEmail(ErrorMessage = ValidationMessages.EmailInvalid)]
        [System.ComponentModel.DataAnnotations.MaxLength(255, ErrorMessage = ValidationMessages.EmailTooLong)]
        public string Email { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = ValidationMessages.PasswordRequired)]
        public string Password { get; set; } = "";
    }
}
