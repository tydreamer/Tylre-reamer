@page "/admin/users/new"
@attribute [Authorize(Roles = "Admin")]
@inject UserService Users
@inject ToastService Toast
@inject NavigationManager Navigation

<PageTitle>Create User</PageTitle>

<div class="mb-4">
    <a href="admin/users" class="btn btn-link ps-0">&larr; Back to users</a>
    <h1>Create User</h1>
</div>

<div class="row">
    <div class="col-md-6">
        <EditForm Model="formModel" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />
            <div class="mb-3">
                <label class="form-label">Name</label>
                <InputText class="form-control" @bind-Value="formModel.Name" />
                <FirstValidationMessage For="() => formModel.Name" />
            </div>
            <div class="mb-3">
                <label class="form-label">Email</label>
                <InputText class="form-control" type="email" @bind-Value="formModel.Email" />
                <FirstValidationMessage For="() => formModel.Email" />
            </div>
            <div class="mb-3">
                <label class="form-label">Password</label>
                <InputText class="form-control" type="password" @bind-Value="formModel.Password" />
                <FirstValidationMessage For="() => formModel.Password" />
            </div>
            <div class="mb-3">
                <label class="form-label">User Type</label>
                <InputSelect class="form-select" @bind-Value="formModel.Role">
                    <option value="Customer">Regular User</option>
                    <option value="Owner">Restaurant Owner</option>
                </InputSelect>
            </div>
            @if (submitError is not null)
            {
                <div class="alert alert-danger">@submitError</div>
            }
            <button class="btn btn-primary" type="submit" disabled="@saving">
                @(saving ? "Saving..." : "Create")
            </button>
            <a href="admin/users" class="btn btn-outline-secondary ms-2">Cancel</a>
        </EditForm>
    </div>
</div>

@code {
    private UserFormModel formModel = new();
    private string? submitError;
    private bool saving;

    private async Task HandleSubmit()
    {
        saving = true;
        submitError = null;

        var request = new CreateUserRequest(
            formModel.Name,
            formModel.Email,
            formModel.Password,
            formModel.Role);

        var result = await Users.CreateAsync(request);
        saving = false;

        if (!result.Success)
        {
            submitError = result.Error ?? "Failed to create user.";
            return;
        }

        Toast.ShowSuccess($"User \"{request.Name}\" was created successfully.");
        Navigation.NavigateTo("/admin/users");
    }

    private sealed class UserFormModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = ValidationMessages.NameRequired)]
        [System.ComponentModel.DataAnnotations.MaxLength(100, ErrorMessage = ValidationMessages.NameTooLong)]
        public string Name { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = ValidationMessages.EmailRequired)]
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = ValidationMessages.EmailInvalid)]
        [System.ComponentModel.DataAnnotations.MaxLength(255, ErrorMessage = ValidationMessages.EmailTooLong)]
        public string Email { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = ValidationMessages.PasswordRequired)]
        [System.ComponentModel.DataAnnotations.MinLength(6, ErrorMessage = ValidationMessages.PasswordTooShort)]
        [System.ComponentModel.DataAnnotations.MaxLength(100, ErrorMessage = ValidationMessages.PasswordTooLong)]
        public string Password { get; set; } = "";

        public string Role { get; set; } = "Customer";
    }
}
