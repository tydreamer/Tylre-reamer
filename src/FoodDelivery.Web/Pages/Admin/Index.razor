@page "/admin/users"
@attribute [Authorize(Roles = "Admin")]
@inject UserService Users
@inject ToastService Toast
@inject PaginatedPageLoadService PageLoad

<PageTitle>Users</PageTitle>

<div class="page-header mb-4">
    <h1 class="mb-0">Users</h1>
    <a href="admin/users/new" class="btn btn-primary">Create User</a>
</div>

@if (error is not null)
{
    <div class="alert alert-danger">@error</div>
}

<UsersTable Paged="@paged" Busy="@busy"
            CurrentPage="@currentPage" PageSize="@pageSize"
            SortBy="@sortBy" SortDesc="@sortDesc"
            OnPageChanged="GoToPage" OnPageSizeChanged="ChangePageSize"
            OnSortChanged="ChangeSortAsync"
            OnRequestBlock="RequestBlock" OnUnblock="UnblockAsync" />

<ConfirmDialog @bind-IsVisible="showBlockDialog"
               Title="Block user"
               Message="@blockDialogMessage"
               ConfirmText="Block user"
               CancelText="Cancel"
               ConfirmButtonClass="btn-danger"
               OnConfirmed="BlockConfirmedAsync" />

@code {
    private PagedResult<UserDto>? paged;
    private string? error;
    private bool busy;
    private int currentPage = 1;
    private int pageSize = 20;
    private string sortBy = "name";
    private bool sortDesc;
    private bool showBlockDialog;
    private int? pendingBlockUserId;
    private string blockDialogMessage = "";

    protected override async Task OnInitializedAsync() => await LoadPageAsync();

    private async Task LoadPageAsync()
    {
        paged = await Users.GetPageAsync(currentPage, pageSize, sortBy, sortDesc);
    }

    private async Task ChangeSortAsync((string SortBy, bool SortDesc) sort)
    {
        sortBy = sort.SortBy;
        sortDesc = sort.SortDesc;
        currentPage = 1;
        await LoadPageAsync();
    }

    private async Task GoToPage(int page)
    {
        if (paged is null || page < 1 || page > paged.TotalPages) return;
        await PageLoad.NavigateAsync(async () =>
        {
            currentPage = page;
            await LoadPageAsync();
        });
        await InvokeAsync(StateHasChanged);
    }

    private async Task ChangePageSize(int size)
    {
        await PageLoad.NavigateAsync(async () =>
        {
            pageSize = size;
            currentPage = 1;
            await LoadPageAsync();
        });
        await InvokeAsync(StateHasChanged);
    }

    private void RequestBlock(UserDto user)
    {
        pendingBlockUserId = user.Id;
        blockDialogMessage = $"Block {user.Name}? They will not be able to sign in to the app.";
        showBlockDialog = true;
    }

    private async Task BlockConfirmedAsync()
    {
        if (pendingBlockUserId is null)
            return;

        await BlockAsync(pendingBlockUserId.Value);
        pendingBlockUserId = null;
        blockDialogMessage = "";
    }

    private async Task BlockAsync(int userId)
    {
        busy = true;
        error = null;
        var (success, err) = await Users.BlockAsync(userId);
        if (success)
            await LoadPageAsync();
        else
            error = err;
        busy = false;
    }

    private async Task UnblockAsync(int userId)
    {
        busy = true;
        error = null;
        var (success, err) = await Users.UnblockAsync(userId);
        if (success)
            await LoadPageAsync();
        else
            error = err;
        busy = false;
    }
}
